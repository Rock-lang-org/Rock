// Dedicated arithmetic operator traits.

> std::mem::sized::Sized
> std::num::integer::Integer

< trait Add Rhs
    type Output
    @+: Rhs -> Self::Output

< trait Sub Rhs
    type Output
    @-: Rhs -> Self::Output

< trait Mul Rhs
    type Output
    @*: Rhs -> Self::Output

< trait Div Rhs
    type Output
    @/: Rhs -> Self::Output

< trait Mod Rhs
    type Output
    @%: Rhs -> Self::Output

impl Add I64 for *T where T: Sized
    type Output = *T

    unsafe @+ = offset -> ~PtrOffset *self, offset

impl Sub I64 for *T where T: Sized
    type Output = *T

    unsafe @- = offset -> *self + offset.wrapping_neg!

impl Add I64 for I64
    type Output = I64
    @+ = other -> if ~OverflowChecks! then ~IntCheckedAdd *self, other else ~IntWrappingAdd *self, other

impl Sub I64 for I64
    type Output = I64
    @- = other -> if ~OverflowChecks! then ~IntCheckedSub *self, other else ~IntWrappingSub *self, other

impl Mul I64 for I64
    type Output = I64
    @* = other -> if ~OverflowChecks! then ~IntCheckedMul *self, other else ~IntWrappingMul *self, other

impl Div I64 for I64
    type Output = I64
    @/ = other -> ~IntCheckedDiv *self, other

impl Mod I64 for I64
    type Output = I64
    @% = other -> ~IntCheckedRem *self, other

