// Dedicated arithmetic operator traits.

> std::mem::sized::Sized

< trait Add Rhs
    type Output
    @+: Rhs -> Self::Output

< trait Sub Rhs
    type Output
    @-: Rhs -> Self::Output

< trait Mul Rhs
    type Output
    @*: Rhs -> Self::Output

< trait Div Rhs
    type Output
    @/: Rhs -> Self::Output

< trait Mod Rhs
    type Output
    @%: Rhs -> Self::Output

impl Add I64 for *T where T: Sized
    type Output = *T

    unsafe @+ = offset -> ~PtrOffset *self, offset

impl Sub I64 for *T where T: Sized
    type Output = *T

    unsafe @- = offset -> ~PtrOffset *self, (~I64Sub 0, offset)

impl Add I64 for I64
    type Output = I64
    @+ = other -> ~I64Add *self, other

impl Sub I64 for I64
    type Output = I64
    @- = other -> ~I64Sub *self, other

impl Mul I64 for I64
    type Output = I64
    @* = other -> ~I64Mul *self, other

impl Div I64 for I64
    type Output = I64
    @/ = other -> ~I64Div *self, other

impl Mod I64 for I64
    type Output = I64
    @% = other -> ~I64Mod *self, other

impl Add I32 for I32
    type Output = I32
    @+ = other -> ~I32Add *self, other

impl Sub I32 for I32
    type Output = I32
    @- = other -> ~I32Sub *self, other

impl Mul I32 for I32
    type Output = I32
    @* = other -> ~I32Mul *self, other

impl Div I32 for I32
    type Output = I32
    @/ = other -> ~I32Div *self, other

impl Mod I32 for I32
    type Output = I32
    @% = other -> ~I32Mod *self, other

impl Add F64 for F64
    type Output = F64
    @+ = other -> ~F64Add *self, other

impl Sub F64 for F64
    type Output = F64
    @- = other -> ~F64Sub *self, other

impl Mul F64 for F64
    type Output = F64
    @* = other -> ~F64Mul *self, other

impl Div F64 for F64
    type Output = F64
    @/ = other -> ~F64Div *self, other

impl Mod F64 for F64
    type Output = F64
    @% = other -> ~F64Mod *self, other

impl Add F32 for F32
    type Output = F32
    @+ = other -> ~F32Add *self, other

impl Sub F32 for F32
    type Output = F32
    @- = other -> ~F32Sub *self, other

impl Mul F32 for F32
    type Output = F32
    @* = other -> ~F32Mul *self, other

impl Div F32 for F32
    type Output = F32
    @/ = other -> ~F32Div *self, other

impl Mod F32 for F32
    type Output = F32
    @% = other -> ~F32Mod *self, other
