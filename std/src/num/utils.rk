// Utility functions
//
// These functions provide common utility operations using intrinsics.

// Absolute value of an integer
< abs = x ->
    if ~I64Lt x, 0
        ~I64Neg x
    else
        x

// Minimum of two integers
< min = a, b ->
    if ~I64Lt a, b
        a
    else
        b

// Maximum of two integers
< max = a, b ->
    if ~I64Gt a, b
        a
    else
        b
