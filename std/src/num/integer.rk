    @min_value = -> 0 as U32
    @max_value = -> ~U32Not (0 as U32)
    @is_negative = -> false
    @is_zero = -> ~U32Eq *self, (0 as U32)
    @overflowing_add = other -> ~IntOverflowingAdd *self, other
    @overflowing_sub = other -> ~IntOverflowingSub *self, other
    @overflowing_mul = other -> ~IntOverflowingMul *self, other
    @overflowing_div = other -> ~IntOverflowingDiv *self, other
    @overflowing_rem = other -> ~IntOverflowingRem *self, other
    @overflowing_neg = -> ~IntOverflowingNeg *self
