// Eq trait - provides equality comparison operators.

< trait Eq
    @==: &Self -> Bool
    @!=: &Self -> Bool
    @!= = other ->
        if *self == *other
            false
        else
            true

impl Eq for I64
    @== = other -> ~I64Eq *self, *other

impl Eq for I32
    @== = other -> ~I32Eq *self, *other

impl Eq for U8
    @== = other -> ~U8Eq *self, *other

impl Eq for F64
    @== = other -> ~F64Eq *self, *other

impl Eq for F32
    @== = other -> ~F32Eq *self, *other

impl Eq for Bool
    @== = other -> ~BoolEq *self, *other

// &Str implementation for UTF-8 string slices / static string literals.
impl Eq for &Str
    @== = other ->
        lhs_str = *self
        rhs_str = *other
        len = ~ArrayLen lhs_str
        other_len = ~ArrayLen rhs_str
        if len != other_len
            false
        else
            lhs = ~ArrPtr lhs_str
            rhs = ~ArrPtr rhs_str
            i = 0
            equal = true
            while equal && i < len
                left = unsafe lhs[i]
                right = unsafe rhs[i]
                if left != right
                    equal = false
                i = i + 1
            equal
