// Partial equality owns the operators; Eq additionally promises reflexivity.

< trait PartialEq Rhs
    @==: &Rhs -> Bool
    @!=: &Rhs -> Bool
    @!= = other -> !(*self == *other)

< trait Eq where Self: PartialEq Self

impl PartialEq I64 for I64
    @== = other -> ~I64Eq *self, *other

impl PartialEq I32 for I32
    @== = other -> ~I32Eq *self, *other

impl PartialEq I16 for I16
    @== = other -> ~I16Eq *self, *other

impl PartialEq I8 for I8
    @== = other -> ~I8Eq *self, *other

impl PartialEq U64 for U64
    @== = other -> ~U64Eq *self, *other

impl PartialEq U32 for U32
    @== = other -> ~U32Eq *self, *other

impl PartialEq U16 for U16
    @== = other -> ~U16Eq *self, *other

impl PartialEq U8 for U8
    @== = other -> ~U8Eq *self, *other

impl PartialEq Char for Char
    @== = other -> (*self as U32) == (*other as U32)

impl PartialEq F64 for F64
    @== = other -> ~F64Eq *self, *other

impl PartialEq F32 for F32
    @== = other -> ~F32Eq *self, *other

impl PartialEq Bool for Bool
    @== = other -> ~BoolEq *self, *other

// &Str implementation for UTF-8 string slices / static string literals.
impl PartialEq &Str for &Str
    @== = other ->
        lhs_str = *self
        rhs_str = *other
        len = lhs_str.len!
        other_len = rhs_str.len!
        if len != other_len
            false
        else
            lhs = lhs_str.as_ptr!
            rhs = rhs_str.as_ptr!
            i = 0
            equal = true
            while equal && i < len
                left = unsafe lhs[i]
                right = unsafe rhs[i]
                if left != right
                    equal = false
                i = i + 1
            equal

impl PartialEq () for ()
    @== = other -> true

impl Eq for I64
impl Eq for I32
impl Eq for I16
impl Eq for I8
impl Eq for U64
impl Eq for U32
impl Eq for U16
impl Eq for U8
impl Eq for Char
impl Eq for Bool
impl Eq for &Str
impl Eq for ()
