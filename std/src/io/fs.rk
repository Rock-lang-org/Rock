// File manipulation API backed by POSIX descriptors.

> std::mem::drop::Drop
> std::io::traits::IoError
> std::io::traits::Read
> std::io::traits::Write
> std::io::traits::last_os_error
> std::io::traits::write_all
> std::io::traits::write_str
> std::ffi::libc::close
> std::ffi::libc::open
> std::ffi::libc::read
> std::ffi::libc::write
> std::control::result::Result
> std::string::owned::String
> std::collections::vec::Vec
> std::control::option::Option

< struct File
    fd: I32

// Linux open(2) flags remain private backend details.
o_rdonly = -> 0
o_wronly = -> 1
o_creat = -> 64
o_trunc = -> 512
o_append = -> 1024
default_mode = -> 438

// Linux errno for an interrupted system call; the read loop retries on it.
eintr = -> 4

path_has_nul: &Str -> Bool
path_has_nul = path ->
    ptr = path.as_ptr!
    len = path.len!
    i = 0
    while i < len
        if (unsafe ptr[i]) == (0 as U8)
            return true
        i = i + 1
    false

file_from_fd: I32 -> File
file_from_fd = fd ->
    unsafe *((&fd) as *File)

open_with_flags: &Str -> I32 -> Result File, IoError
open_with_flags = path, flags ->
    if path_has_nul path
        err = IoError::InvalidPath
        Result::Err err
    else
        owned_path = String::from path
        fd = open owned_path.as_ptr!, flags, default_mode!
        if fd < (0 as I32)
            Result::Err (last_os_error!)
        else
            Result::Ok (file_from_fd fd)

impl File
    open: &Str -> Result File, IoError
    open = path ->
        open_with_flags path, o_rdonly!

    create: &Str -> Result File, IoError
    create = path ->
        open_with_flags path, ((o_wronly!) | (o_creat!) | (o_trunc!))

    append: &Str -> Result File, IoError
    append = path ->
        open_with_flags path, ((o_wronly!) | (o_creat!) | (o_append!))

impl Read for File
    ^@read: &mut [U8] -> Result I64, IoError
    ^@read = buf ->
        count = read self.fd, buf.as_mut_ptr!, buf.len!
        if count < 0
            Result::Err (last_os_error!)
        else
            Result::Ok count

// Read through EOF, preserving all bytes and rejecting invalid UTF-8.
read_to_string: &Str -> Result String, IoError
< read_to_string = path ->
    mut file = File::open path?
    mut bytes: Vec U8 = Vec::new!
    mut buffer: [U8; 8192] = [0; 8192]
    done = false
    while !done
        match file.read (&mut buffer)
            Result::Ok count =>
                if count == 0
                    done = true
                else
                    bytes.extend_from_slice (&buffer[..count])
            Result::Err (IoError::Os code) =>
                // Retry on EINTR without losing bytes from earlier reads.
                if code != eintr!
                    failure: Result String, IoError = Result::Err (IoError::Os code)
                    return failure
            Result::Err error =>
                failure: Result String, IoError = Result::Err error
                return failure
    match String::from_utf8 bytes.as_slice!
        Option::Some text => Result::Ok text
        Option::None => Result::Err IoError::InvalidData

impl Write for File
    @write: &[U8] -> Result I64, IoError
    @write = buf ->
        count = write self.fd, buf.as_ptr!, buf.len!
        if count < 0
            Result::Err (last_os_error!)
        else
            Result::Ok count

    @write_str = value -> write_str self, value
    @write_all = buf -> write_all self, buf

impl Drop for File
    ~@drop = ->
        closed = close self.fd
        return
