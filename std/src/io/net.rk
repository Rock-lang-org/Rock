// Blocking IPv4 TCP networking over std::sys socket handles.

> std::mem::drop::Drop
> std::io::traits::IoError
> std::io::traits::Read
> std::io::traits::Write
> std::io::traits::write_all
> std::io::traits::write_str
> std::sys::sock_last_error
> std::sys::sock_open
> std::sys::sock_bind
> std::sys::sock_listen
> std::sys::sock_accept
> std::sys::sock_connect
> std::sys::sock_getsockname
> std::sys::sock_recv
> std::sys::sock_send
> std::sys::sock_shutdown
> std::sys::sock_close
> std::sys::sockaddr_v4_set_family
> std::mem::raw_buffer::RawBuffer
> std::control::result::Result

< struct Ipv4Addr
    < a: U8
    < b: U8
    < c: U8
    < d: U8

< struct SocketAddrV4
    < ip: Ipv4Addr
    < port: I64

// A negative handle means the socket was already closed explicitly.
< struct TcpListener
    sock: I64

< struct TcpStream
    sock: I64

sockaddr_in_len = -> 16 as I32
somaxconn_default = -> 128 as I32

unit = ->
    return

port_is_valid: I64 -> Bool
port_is_valid = port -> port >= 0 && port <= 65535

last_socket_error: () -> IoError
last_socket_error = -> IoError::Os (sock_last_error!)

// struct sockaddr_in: family header (backend-specific), port and address in
// network byte order, zero padding.
sockaddr_v4_new: SocketAddrV4 -> RawBuffer U8
sockaddr_v4_new = addr ->
    raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (sockaddr_in_len! as I64)
    mut buf = raw.ptr!
    i = 0 as I64
    while i < (sockaddr_in_len! as I64)
        unsafe buf[i] = 0
        i = i + 1
    sockaddr_v4_set_family buf
    port = addr.port as U16
    unsafe
        buf[2] = (port >> (8 as U16)) as U8
        buf[3] = (port & (255 as U16)) as U8
        buf[4] = addr.ip.a
        buf[5] = addr.ip.b
        buf[6] = addr.ip.c
        buf[7] = addr.ip.d
    raw

sockaddr_v4_read: *U8 -> SocketAddrV4
sockaddr_v4_read = buf ->
    high = unsafe buf[2]
    low = unsafe buf[3]
    SocketAddrV4
        ip: Ipv4Addr
            a: unsafe buf[4]
            b: unsafe buf[5]
            c: unsafe buf[6]
            d: unsafe buf[7]
        port: ((high as I64) * 256) + (low as I64)

tcp_listener: I64 -> TcpListener
tcp_listener = sock ->
    unsafe *((&sock) as *TcpListener)

tcp_stream: I64 -> TcpStream
tcp_stream = sock ->
    unsafe *((&sock) as *TcpStream)

close_socket: I64 -> Result (), IoError
close_socket = sock ->
    if sock_close sock < (0 as I32)
        Result::Err (last_socket_error!)
    else
        Result::Ok (unit!)

tcp_stream_read: I64 -> &mut [U8] -> Result I64, IoError
tcp_stream_read = sock, buf ->
    count = sock_recv sock, buf.as_mut_ptr!, buf.len!
    if count < 0
        Result::Err (last_socket_error!)
    else
        Result::Ok count

tcp_stream_write: I64 -> &[U8] -> Result I64, IoError
tcp_stream_write = sock, buf ->
    count = sock_send sock, buf.as_ptr!, buf.len!
    if count < 0
        Result::Err (last_socket_error!)
    else
        Result::Ok count

tcp_shutdown: I64 -> I32 -> Result (), IoError
tcp_shutdown = sock, how ->
    if sock_shutdown sock, how < (0 as I32)
        Result::Err (last_socket_error!)
    else
        Result::Ok (unit!)

impl Ipv4Addr
    localhost = ->
        Ipv4Addr
            a: 127
            b: 0
            c: 0
            d: 1

    any = ->
        Ipv4Addr
            a: 0
            b: 0
            c: 0
            d: 0

    new = a, b, c, d ->
        Ipv4Addr
            a: a
            b: b
            c: c
            d: d

impl SocketAddrV4
    new = ip, port ->
        SocketAddrV4
            ip: ip
            port: port

    localhost = port ->
        SocketAddrV4
            ip: Ipv4Addr::localhost!
            port: port

    any = port ->
        SocketAddrV4
            ip: Ipv4Addr::any!
            port: port

impl TcpListener
    bind: SocketAddrV4 -> Result TcpListener, IoError
    bind = addr ->
        if !(port_is_valid addr.port)
            err = IoError::InvalidAddress
            Result::Err err
        else
            sock = sock_open!
            if sock < 0
                Result::Err (last_socket_error!)
            else
                sockaddr = sockaddr_v4_new addr
                if sock_bind sock, sockaddr.ptr!, sockaddr_in_len! < (0 as I32)
                    // Preserve the bind error; cleanup must not replace it.
                    err = last_socket_error!
                    close_socket sock
                    Result::Err (err)
                else if sock_listen sock, somaxconn_default! < (0 as I32)
                    err = last_socket_error!
                    close_socket sock
                    Result::Err (err)
                else
                    Result::Ok (tcp_listener sock)

impl TcpListener
    @local_addr: Result SocketAddrV4, IoError
    @local_addr = ->
        sockaddr = sockaddr_v4_new (SocketAddrV4::any 0)
        mut len = sockaddr_in_len!
        result = sock_getsockname self.sock, sockaddr.ptr!, ((&mut len) as *I32)
        if result < (0 as I32)
            Result::Err (last_socket_error!)
        else
            Result::Ok (sockaddr_v4_read (sockaddr.ptr!))

impl TcpListener
    @accept: Result TcpStream, IoError
    @accept = ->
        sockaddr = sockaddr_v4_new (SocketAddrV4::any 0)
        mut len = sockaddr_in_len!
        sock = sock_accept self.sock, sockaddr.ptr!, ((&mut len) as *I32)
        if sock < 0
            Result::Err (last_socket_error!)
        else
            Result::Ok (tcp_stream sock)

impl TcpStream
    connect: SocketAddrV4 -> Result TcpStream, IoError
    connect = addr ->
        if !(port_is_valid addr.port)
            err = IoError::InvalidAddress
            Result::Err err
        else
            sock = sock_open!
            if sock < 0
                Result::Err (last_socket_error!)
            else
                sockaddr = sockaddr_v4_new addr
                if sock_connect sock, sockaddr.ptr!, sockaddr_in_len! < (0 as I32)
                    err = last_socket_error!
                    close_socket sock
                    Result::Err (err)
                else
                    Result::Ok (tcp_stream sock)

impl Read for TcpStream
    ^@read: &mut [U8] -> Result I64, IoError
    ^@read = buf ->
        tcp_stream_read self.sock, buf

impl Write for TcpStream
    @write: &[U8] -> Result I64, IoError
    @write = buf ->
        tcp_stream_write self.sock, buf

    @write_str = value -> write_str self, value
    @write_all = buf -> write_all self, buf

impl TcpStream
    @recv: &mut [U8] -> Result I64, IoError
    @recv = buf ->
        tcp_stream_read self.sock, buf

    @send: &[U8] -> Result I64, IoError
    @send = buf ->
        tcp_stream_write self.sock, buf

    @shutdown: Result (), IoError
    @shutdown = ->
        tcp_shutdown self.sock, (2 as I32)

    @shutdown_write: Result (), IoError
    @shutdown_write = ->
        tcp_shutdown self.sock, (1 as I32)

impl TcpListener
    ~@close: Result (), IoError
    ~@close = ->
        sock = self.sock
        self.sock = 0 - 1
        close_socket sock

impl TcpStream
    ~@close: Result (), IoError
    ~@close = ->
        sock = self.sock
        self.sock = 0 - 1
        close_socket sock

// Destructors cannot return errors: use explicit close to observe them.
impl Drop for TcpListener
    ~@drop = ->
        if self.sock >= 0
            close_socket self.sock
        return

impl Drop for TcpStream
    ~@drop = ->
        if self.sock >= 0
            close_socket self.sock
        return
