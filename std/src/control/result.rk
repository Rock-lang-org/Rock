// Result T, E - represents success (Ok) or failure (Err)

> std::show::Show
> std::string::owned::String
> std::convert::From
> std::control::control_flow::ControlFlow
> std::control::control_flow::FromResidual
> std::control::control_flow::Try
> std::functional::callable::FnMut
> std::functional::bifunctor::Bifunctor
> std::functional::functor::Functor
> std::functional::applicative::Applicative
> std::functional::monad::Monad
> std::functional::foldable::Foldable
> std::functional::traversable::Traversable

< enum Result T, E
    Ok T
    Err E

< enum ResultResidual E
    Err E

result_map: Result T, E -> (T -> U) -> Result U, E
result_map = res, f ->
    match res
        Result::Ok val => Result::Ok (f val)
        Result::Err err => Result::Err err

result_and_then: Result T, E -> (T -> Result U, E) -> Result U, E
result_and_then = res, f ->
    match res
        Result::Ok val => f val
        Result::Err err => Result::Err err

impl Bifunctor for Result
    bimap = mut map_ok, mut map_err, value ->
        match value
            Result::Ok item => Result::Ok (map_ok item)
            Result::Err error => Result::Err (map_err error)

impl Functor for Result _, E
    fmap = mut mapper, value ->
        match value
            Result::Ok item => Result::Ok (mapper item)
            Result::Err error => Result::Err error

impl Applicative for Result _, E
    pure = value -> Result::Ok value

    ap = wrapped_function, wrapped_value ->
        match wrapped_function
            Result::Ok function =>
                match wrapped_value
                    Result::Ok value => Result::Ok (function value)
                    Result::Err error => Result::Err error
            Result::Err error => Result::Err error

impl Monad for Result _, E
    bind = value, mut callback ->
        match value
            Result::Ok item => callback item
            Result::Err error => Result::Err error

impl Foldable for Result _, E
    try_fold = mut step, initial, value ->
        match value
            Result::Ok item => step (initial, item)
            Result::Err _ => ControlFlow::Continue initial

impl Traversable for Result _, E
    traverse = mut visitor, value ->
        match value
            Result::Ok item =>
                effect = visitor item
                wrap: B -> Result B, E = mapped -> Result::Ok mapped
                G::ap (G::pure wrap), effect
            Result::Err error =>
                failed: Result B, E = Result::Err error
                G::pure failed

    traverse_m = mut visitor, value ->
        match value
            Result::Ok item =>
                effect = visitor item
                G::bind effect, (mapped ->
                    success: Result B, E = Result::Ok mapped
                    G::pure success)
            Result::Err error =>
                failed: Result B, E = Result::Err error
                G::pure failed

impl Result T, E
    ~@map: (T -> U) -> Result U, E
    ~@and_then: (T -> Result U, E) -> Result U, E
    ~@map = f ->
        match self
            Result::Ok val => Result::Ok (f val)
            Result::Err err => Result::Err err

    ~@map_err = f ->
        match self
            Result::Ok val => Result::Ok val
            Result::Err err => Result::Err (f err)

    ~@and_then = f ->
        match self
            Result::Ok val => f val
            Result::Err err => Result::Err err

    ~@or = other ->
        match self
            Result::Ok val => Result::Ok val
            Result::Err _ => other

    ~@unwrap_or = default ->
        match self
            Result::Ok val => val
            Result::Err _ => default

    ~@fold = on_err, on_ok ->
        match self
            Result::Ok val => on_ok val
            Result::Err err => on_err err

    ~@<|>: Result T, E -> Result T, E
    ~@<|> = other -> self.or other

impl Result (Result T, E), E
    ~@flatten = ->
        match self
            Result::Ok inner => inner
            Result::Err err => Result::Err err

impl Try for Result T, E
    type Output = T
    type Residual = ResultResidual E

    ~@branch = ->
        match self
            Result::Ok val => ControlFlow::Continue val
            Result::Err err => ControlFlow::Break (ResultResidual::Err err)

impl FromResidual ResultResidual E for Result T, F where F: From E
    from_residual = residual ->
        match residual
            ResultResidual::Err err => Result::Err (F::from err)

impl Show for Result T, E where T: Show, E: Show
    @show = ->
        match *self
            Result::Ok val =>
                start = String::from "Ok("
                body = start.concat (val.show!)
                body.concat (String::from ")")
            Result::Err err =>
                start = String::from "Err("
                body = start.concat (err.show!)
                body.concat (String::from ")")
