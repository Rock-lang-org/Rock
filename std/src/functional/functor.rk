// Functor maps a consuming callback over a type constructor.

> std::functional::callable::FnMut
> std::collections::vec::Vec

< trait Functor for F _
    fmap: M -> F A -> F B where M: FnMut A, B

fmap: M -> F A -> F B where F _: Functor, M: FnMut A, B
< fmap = mapper, value -> F::Functor::fmap mapper, value

// Bridge a fully applied value to its constructor's consuming operation.
< trait FunctorValue A, B, Output
    ~@fmap: M -> Output where M: FnMut A, B

impl FunctorValue A, B, F B for F A where F _: Functor
    ~@fmap = mapper -> F::Functor::fmap mapper, self

impl FunctorValue &A, B, Vec B for &[A]
    ~@fmap = mut mapper ->
        mut output = Vec::new!
        index = 0
        while index < self.len!
            output.push (mapper (&self[index]))
            index = index + 1
        output

impl FunctorValue A, B, Vec B for [A; N]
    ~@fmap = mut mapper ->
        mut output = Vec::new!
        for item in self
            output.push (mapper item)
        output

// The operators stay constructor-shaped (`F A -> F B`) so signatureless
// helpers can infer the constructor; arrays and slices map with `.fmap`.
<$>: M -> F A -> F B where F _: Functor, M: FnMut A, B
<$> = mapper, value -> F::Functor::fmap mapper, value

<&>: F A -> M -> F B where F _: Functor, M: FnMut A, B
<&> = value, mapper -> F::Functor::fmap mapper, value
