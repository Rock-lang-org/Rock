> std::ffi::libc::exit
> std::ffi::libc::puts
> std::mem::sized::Sized
> std::ops::range::Range

lang index
< trait Index Idx
    lang output
    type Output
    lang method
    @index: Idx -> &Self::Output

lang index_mut
< trait IndexMut Idx
    lang output
    type Output
    lang method
    ^@index_mut: Idx -> &mut Self::Output

index_bounds_check: I64 -> I64 -> ()
index_bounds_check = index, len ->
    if index < 0 || index >= len
        puts (~ArrPtr "index out of bounds")
        exit (1 as I32)

range_bounds_check: Range -> I64 -> (I64, I64)
< range_bounds_check = range, len ->
    bounds = match range
        Range::Full => (0, len)
        Range::From start => (start, len)
        Range::To end => (0, end)
        Range::ToInclusive end =>
            if end < 0 || end >= len
                (0, 0 - 1)
            else
                (0, end + 1)
        Range::Exclusive start, end => (start, end)
        Range::Inclusive start, end =>
            if end < 0 || end >= len
                (0, 0 - 1)
            else
                (start, end + 1)
    start = bounds.0
    end = bounds.1
    if start < 0 || end < start || end > len
        puts (~ArrPtr "range out of bounds")
        exit (1 as I32)
    bounds

borrow_slice_range: *T -> I64 -> I64 -> &[T]
< borrow_slice_range = ptr, start, len ->
    offset: *T = unsafe ~PtrOffset ptr, start
    unsafe ~BorrowSlice offset, len

borrow_slice_range_mut: *T -> I64 -> I64 -> &mut [T]
< borrow_slice_range_mut = ptr, start, len ->
    offset: *T = unsafe ~PtrOffset ptr, start
    unsafe ~BorrowSliceMut offset, len

impl Index I64 for &[T]
    type Output = T
    @index = i ->
        slice = *self
        index_bounds_check i, (~ArrayLen slice)
        ptr = ~ArrPtr slice
        unsafe &*(~PtrOffset ptr, i)

impl IndexMut I64 for &mut [T]
    type Output = T
    ^@index_mut = i ->
        slice = &*self
        index_bounds_check i, (~ArrayLen slice)
        ptr = ~ArrPtr slice
        unsafe &mut *(~PtrOffset ptr, i)

impl Index Range for &[T]
    type Output = [T]
    @index = range ->
        slice = *self
        bounds = range_bounds_check range, (~ArrayLen slice)
        slice_ptr: *T = ~ArrPtr slice
        borrow_slice_range slice_ptr, bounds.0, (bounds.1 - bounds.0)

impl IndexMut Range for &mut [T]
    type Output = [T]
    ^@index_mut = range ->
        slice = &*self
        bounds = range_bounds_check range, (~ArrayLen slice)
        slice_ptr: *T = ~ArrPtr slice
        borrow_slice_range_mut slice_ptr, bounds.0, (bounds.1 - bounds.0)

impl Index I64 for *T where T: Sized
    type Output = T
    unsafe @index = i -> unsafe &*(~PtrOffset *self, i)

impl IndexMut I64 for *T where T: Sized
    type Output = T
    unsafe ^@index_mut = i -> unsafe &mut *(~PtrOffset *self, i)

impl Index I64 for *[T]
    type Output = T
    unsafe @index = i ->
        slice = unsafe *(*self)
        index_bounds_check i, (~ArrayLen slice)
        ptr = ~ArrPtr slice
        unsafe &*(~PtrOffset ptr, i)

impl IndexMut I64 for *[T]
    type Output = T
    unsafe ^@index_mut = i ->
        slice = unsafe *(*self)
        index_bounds_check i, (~ArrayLen slice)
        ptr = ~ArrPtr slice
        unsafe &mut *(~PtrOffset ptr, i)
