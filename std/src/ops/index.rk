> std::ffi::libc::exit
> std::ffi::libc::puts
> std::mem::sized::Sized
> std::ops::range::Range
> std::collections::slice::slice_from_raw_parts
> std::collections::slice::slice_from_raw_parts_mut

lang index
< trait Index Idx
    lang output
    type Output
    lang method
    @index: Idx -> &Self::Output

lang index_mut
< trait IndexMut Idx
    lang output
    type Output
    lang method
    ^@index_mut: Idx -> &mut Self::Output

index_bounds_check: I64 -> I64 -> ()
index_bounds_check = index, len ->
    if index < 0 || index >= len
        puts "index out of bounds".as_ptr!
        exit (1 as I32)

range_bounds_check: Range -> I64 -> (I64, I64)
< range_bounds_check = range, len ->
    bounds = match range
        Range::Full => (0, len)
        Range::From start => (start, len)
        Range::To end => (0, end)
        Range::ToInclusive end =>
            if end < 0 || end >= len
                (0, 0 - 1)
            else
                (0, end + 1)
        Range::Exclusive start, end => (start, end)
        Range::Inclusive start, end =>
            if end < 0 || end >= len
                (0, 0 - 1)
            else
                (start, end + 1)
    start = bounds.0
    end = bounds.1
    if start < 0 || end < start || end > len
        puts "range out of bounds".as_ptr!
        exit (1 as I32)
    bounds

// The caller validates bounds and the allocation/borrow contract of the range.
unsafe borrow_slice_range: *T -> I64 -> I64 -> &[T]
< unsafe borrow_slice_range = ptr, start, len ->
    offset: *T = unsafe ptr + start
    unsafe slice_from_raw_parts offset, len

unsafe borrow_slice_range_mut: *T -> I64 -> I64 -> &mut [T]
< unsafe borrow_slice_range_mut = ptr, start, len ->
    offset: *T = unsafe ptr + start
    unsafe slice_from_raw_parts_mut offset, len

impl Index I64 for &[T]
    type Output = T
    @index = i ->
        slice = *self
        index_bounds_check i, slice.len!
        ptr = slice.as_ptr!
        unsafe &ptr[i]

impl IndexMut I64 for &mut [T]
    type Output = T
    ^@index_mut = i ->
        slice = &mut *self
        index_bounds_check i, slice.len!
        mut ptr = slice.as_mut_ptr!
        unsafe &mut ptr[i]

impl Index Range for &[T]
    type Output = [T]
    @index = range ->
        slice = *self
        bounds = range_bounds_check range, slice.len!
        slice_ptr: *T = slice.as_ptr!
        unsafe borrow_slice_range slice_ptr, bounds.0, (bounds.1 - bounds.0)

impl IndexMut Range for &mut [T]
    type Output = [T]
    ^@index_mut = range ->
        slice = &mut *self
        bounds = range_bounds_check range, slice.len!
        slice_ptr: *T = slice.as_mut_ptr!
        unsafe borrow_slice_range_mut slice_ptr, bounds.0, (bounds.1 - bounds.0)

impl Index I64 for *T where T: Sized
    type Output = T
    unsafe @index = i -> unsafe &*((*self) + i)

impl IndexMut I64 for *T where T: Sized
    type Output = T
    unsafe ^@index_mut = i -> unsafe &mut *((*self) + i)

impl Index I64 for *[T]
    type Output = T
    unsafe @index = i ->
        slice = unsafe &*(*self)
        index_bounds_check i, slice.len!
        ptr = slice.as_ptr!
        unsafe &ptr[i]

impl IndexMut I64 for *[T]
    type Output = T
    unsafe ^@index_mut = i ->
        slice = unsafe &mut *(*self)
        index_bounds_check i, slice.len!
        mut ptr = slice.as_mut_ptr!
        unsafe &mut ptr[i]
