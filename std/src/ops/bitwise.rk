// Independent bitwise and shift protocols, matching arithmetic operators.

< trait BitOr Rhs
    type Output
    @|: Rhs -> Self::Output

< trait BitXor Rhs
    type Output
    @^: Rhs -> Self::Output

< trait BitAnd Rhs
    type Output
    @&: Rhs -> Self::Output

< trait Shl Rhs
    type Output
    @<<: Rhs -> Self::Output

< trait Shr Rhs
    type Output
    @>>: Rhs -> Self::Output

impl BitOr I64 for I64
    type Output = I64
    @| = other -> ~I64Or *self, other

impl BitXor I64 for I64
    type Output = I64
    @^ = other -> ~I64Xor *self, other

impl BitAnd I64 for I64
    type Output = I64
    @& = other -> ~I64And *self, other

impl Shl I64 for I64
    type Output = I64
    @<< = other -> if ~OverflowChecks! then ~IntCheckedShl *self, other else ~IntWrappingShl *self, other

impl Shr I64 for I64
    type Output = I64
    @>> = other -> if ~OverflowChecks! then ~IntCheckedShr *self, other else ~IntWrappingShr *self, other

