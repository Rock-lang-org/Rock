// Compound assignment uses ordinary mutable receiver methods.

> std::mem::sized::Sized

< trait AddAssign Rhs
    ^@+=: Rhs -> ()

< trait SubAssign Rhs
    ^@-=: Rhs -> ()

< trait MulAssign Rhs
    ^@*=: Rhs -> ()

< trait DivAssign Rhs
    ^@/=: Rhs -> ()

< trait ModAssign Rhs
    ^@%=: Rhs -> ()

< trait BitAndAssign Rhs
    ^@&=: Rhs -> ()

< trait BitOrAssign Rhs
    ^@|=: Rhs -> ()

< trait BitXorAssign Rhs
    ^@^=: Rhs -> ()

< trait ShlAssign Rhs
    ^@<<=: Rhs -> ()

< trait ShrAssign Rhs
    ^@>>=: Rhs -> ()

impl AddAssign I64 for *T where T: Sized
    unsafe ^@+= = rhs -> *self = (*self) + rhs

impl SubAssign I64 for *T where T: Sized
    unsafe ^@-= = rhs -> *self = (*self) - rhs

impl AddAssign I8 for I8
    ^@+= = rhs -> *self = (*self) + rhs

impl SubAssign I8 for I8
    ^@-= = rhs -> *self = (*self) - rhs

impl MulAssign I8 for I8
    ^@*= = rhs -> *self = (*self) * rhs

impl DivAssign I8 for I8
    ^@/= = rhs -> *self = (*self) / rhs

impl ModAssign I8 for I8
    ^@%= = rhs -> *self = (*self) % rhs

impl BitAndAssign I8 for I8
    ^@&= = rhs -> *self = (*self) & rhs

impl BitOrAssign I8 for I8
    ^@|= = rhs -> *self = (*self) | rhs

impl BitXorAssign I8 for I8
    ^@^= = rhs -> *self = (*self) ^ rhs

impl ShlAssign I8 for I8
    ^@<<= = rhs -> *self = (*self) << rhs

impl ShrAssign I8 for I8
    ^@>>= = rhs -> *self = (*self) >> rhs

