// macOS (Darwin libSystem) backend for std::sys.

> std::ffi::libc::close
// Darwin's open is variadic and arm64 passes variadic arguments on the stack,
// so it is only ever called without the mode argument; creation goes through
// creat, which takes the mode as a fixed argument.
> std::ffi::libc::open
> std::ffi::libc::creat
> std::ffi::libc::__error

errno_location: () -> *I32
< errno_location = -> __error!

o_rdonly: () -> I32
< o_rdonly = -> 0 as I32
o_wronly: () -> I32
< o_wronly = -> 1 as I32
o_creat: () -> I32
< o_creat = -> 512 as I32
o_trunc: () -> I32
< o_trunc = -> 1024 as I32
o_append: () -> I32
< o_append = -> 8 as I32

eintr: () -> I32
< eintr = -> 4 as I32

enoent = -> 2 as I32

// 0666, narrowed by the process umask.
default_mode = -> 438 as I32

// std opens only read, create-truncate and create-append. creat(2) is exactly
// O_WRONLY | O_CREAT | O_TRUNC. Append first opens an existing file; when it
// is missing, creat makes it (empty) and the append open is retried.
open_file: *U8 -> I32 -> I32
< open_file = path, flags ->
    if (flags & (o_creat!)) == (0 as I32)
        open path, flags
    else if (flags & (o_trunc!)) != (0 as I32)
        creat path, default_mode!
    else
        plain = flags - (o_creat!)
        fd = open path, plain
        if fd >= (0 as I32) || (unsafe *(__error!)) != (enoent!)
            fd
        else
            created = creat path, default_mode!
            if created < (0 as I32)
                created
            else
                close created
                open path, plain

// Darwin has no MSG_NOSIGNAL; broken pipes are reported via SIGPIPE.
msg_nosignal: () -> I32
< msg_nosignal = -> 0 as I32

// struct sockaddr_in starts with an 8-bit length and an 8-bit family.
sockaddr_v4_set_family: *U8 -> ()
< sockaddr_v4_set_family = buf ->
    unsafe
        *buf = 16 as U8
        *(buf + 1) = 2 as U8
