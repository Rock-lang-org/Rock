// macOS (Darwin libSystem) backend for std::sys.

// See std::ffi::libc for how this fixed-arity binding passes open's mode.
> std::ffi::libc::open
> std::ffi::libc::setsockopt
> std::ffi::libc::__error

errno_location: () -> *I32
< errno_location = -> __error!

o_rdonly: () -> I32
< o_rdonly = -> 0 as I32
o_wronly: () -> I32
< o_wronly = -> 1 as I32
o_creat: () -> I32
< o_creat = -> 512 as I32
o_trunc: () -> I32
< o_trunc = -> 1024 as I32
o_append: () -> I32
< o_append = -> 8 as I32

eintr: () -> I32
< eintr = -> 4 as I32

// 0666, narrowed by the process umask.
default_mode = -> 438 as I64

// One open call, so O_CREAT | O_APPEND creates atomically and never
// truncates a file another process created meanwhile.
open_file: *U8 -> I32 -> I32
< open_file = path, flags ->
    mode = default_mode!
    open path, flags, mode, 0, 0, 0, 0, 0, mode

// Darwin has no MSG_NOSIGNAL; SO_NOSIGPIPE on each socket makes writes to a
// closed peer fail with EPIPE instead of raising SIGPIPE.
msg_nosignal: () -> I32
< msg_nosignal = -> 0 as I32

sock_prepare: I64 -> I32
< sock_prepare = sock ->
    mut enabled = 1 as I32
    // SOL_SOCKET, SO_NOSIGPIPE
    setsockopt (sock as I32), (65535 as I32), (4130 as I32), ((&mut enabled) as *U8), (4 as I32)

// struct sockaddr_in starts with an 8-bit length and an 8-bit family.
sockaddr_v4_set_family: *U8 -> ()
< sockaddr_v4_set_family = buf ->
    unsafe
        *buf = 16 as U8
        *(buf + 1) = 2 as U8
