// Heap-allocated String type
//
// This is a pure std implementation - NOT a compiler builtin.
// String is a struct that wraps a heap-allocated buffer.

> std::sys::gcvt
> std::ffi::libc::memcpy
> std::ffi::libc::strlen
> std::ffi::libc::puts
> std::ffi::libc::exit
> std::clone::Clone
> std::cmp::eq::PartialEq
> std::cmp::eq::Eq
> std::convert::From
> std::mem::drop::Drop
> std::num::arithmetic::Add
> std::mem::raw_buffer::RawBuffer
> std::string::operations::is_utf8
> std::string::operations::str_char_at
> std::control::option::Option
> std::collections::slice::slice_from_raw_parts
> std::string::operations::str_from_utf8_unchecked
> std::string::operations::str_is_char_boundary
> std::string::operations::str_char_at_byte
> std::mem::alloc::checked_add_i64
> std::mem::alloc::checked_grow_capacity
> std::cmp::ord::Ord
> std::cmp::ord::PartialOrd
> std::hash::Hash

// Heap-allocated string type
< struct String
    raw: RawBuffer U8
    raw_len: I64

// Constructor: create empty String (static method)
impl String
    new = ->
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, 1
        unsafe *(raw.ptr!) = 0
        String
            raw: raw
            raw_len: 0

impl From &Str for String
    from = s ->
        slice_len = s.len!
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (slice_len + 1)
        mut buf = raw.ptr!
        slice_ptr = s.as_ptr!
        unsafe
            memcpy buf, slice_ptr, slice_len
            buf[slice_len] = 0

        String
            raw: raw
            raw_len: slice_len

impl From &[U8] for String
    from = bytes ->
        if !(is_utf8 bytes)
            puts "invalid UTF-8".as_ptr!
            exit (1 as I32)
        slice_len = bytes.len!
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (slice_len + 1)
        mut buf = raw.ptr!
        slice_ptr = bytes.as_ptr!
        unsafe
            memcpy buf, slice_ptr, slice_len
            buf[slice_len] = 0

        String
            raw: raw
            raw_len: slice_len

impl String
    from_utf8: &[U8] -> Option String
    from_utf8 = bytes ->
        if is_utf8 bytes
            Option::Some (String::from bytes)
        else
            Option::None

    // The pointer must address a valid null-terminated byte string.
    // Invalid UTF-8 is rejected before constructing the owned string.
    unsafe from_c_str: *U8 -> String
    unsafe from_c_str = s ->
        len = strlen s
        bytes = unsafe slice_from_raw_parts s, len
        if !(is_utf8 bytes)
            puts "invalid UTF-8".as_ptr!
            exit (1 as I32)
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (len + 1)
        mut buf = raw.ptr!
        memcpy buf, s, len
        unsafe buf[len] = 0
        String
            raw: raw
            raw_len: len

impl From I64 for String
    from = x -> format_i64 x

impl From U64 for String
    from = x -> format_u64 x

// Decimal formatting helpers used by Show and integer conversions.
format_i64: I64 -> String
< format_i64 = x ->
    mut buf: [U8; 20] = [0 as U8; 20]
    is_neg = x < 0
    // Keep the magnitude negative: MIN has no positive I64 counterpart.
    n = if is_neg then x else 0 - x

    digits = 1
    temp = n
    while temp <= -10
        temp = temp / 10
        digits = digits + 1

    len = digits
    if is_neg
        len = len + 1

    divisor = 1
    i = 1
    while i < digits
        divisor = divisor * 10
        i = i + 1

    out = 0
    if is_neg
        buf[0] = 45 as U8
        out = 1

    while divisor > 0
        digit = 0 - (n / divisor)
        buf[out] = (digit + 48) as U8
        n = n % divisor
        divisor = divisor / 10
        out = out + 1

    String::from (&buf[..len])

format_u64: U64 -> String
< format_u64 = x ->
    mut buf: [U8; 20] = [0 as U8; 20]
    ten = 10 as U64
    temp = x
    digits = 1
    while temp >= ten
        temp = temp / ten
        digits = digits + 1

    n = x
    i = digits
    while i > 0
        i = i - 1
        digit = (n % ten) as I64
        buf[i] = (digit + 48) as U8
        n = n / ten

    String::from (&buf[..digits])

impl From F64 for String
    from = x ->
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, 32
        mut buf = raw.ptr!
        gcvt x, 6, buf
        len = strlen buf
        String
            raw: raw
            raw_len: len

impl From Char for String
    from = c ->
        value = c as I64
        if value > 1114111 || (value >= 55296 && value <= 57343)
            puts "invalid Unicode scalar".as_ptr!
            exit (1 as I32)
        len = if value < 128 then 1 else if value < 2048 then 2 else if value < 65536 then 3 else 4
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (len + 1)
        mut buf = raw.ptr!
        unsafe
            if len == 1
                *buf = value as U8
            else
                remaining = value
                i = len - 1
                while i > 0
                    buf[i] = (128 + remaining % 64) as U8
                    remaining = remaining / 64
                    i = i - 1
                prefix = if len == 2 then 192 else if len == 3 then 224 else 240
                *buf = (prefix + remaining) as U8
            buf[len] = 0
        String
            raw: raw
            raw_len: len

// Get raw pointer for libc interop
impl String
    @len = -> self.raw_len

    @as_ptr = -> self.raw.ptr!

    @as_str: &Str
    @as_str = -> unsafe str_from_utf8_unchecked (slice_from_raw_parts self.raw.ptr!, self.raw_len)

    @as_bytes: &[U8]
    @as_bytes = -> self.as_str!.as_bytes!

    @char_at: I64 -> Option Char
    @char_at = index -> str_char_at self.as_str!, index

// In-place building. The buffer always keeps one spare byte for the NUL terminator.
impl String
    with_capacity: I64 -> String
    with_capacity = capacity ->
        cap = if capacity > 0 then checked_add_i64 capacity, 1 else 1
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, cap
        unsafe *(raw.ptr!) = 0
        String
            raw: raw
            raw_len: 0

    @capacity: I64
    @capacity = -> self.raw.cap! - 1

    ^@reserve: I64 -> ()
    ^@reserve = additional ->
        extra = if additional > 0 then additional else 0
        needed = checked_add_i64 (checked_add_i64 self.raw_len, extra), 1
        if needed > self.raw.cap!
            new_cap = checked_grow_capacity self.raw.cap!
            while new_cap < needed
                new_cap = checked_grow_capacity new_cap
            new_raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, new_cap
            ptr = new_raw.ptr!
            old_ptr = self.raw.ptr!
            memcpy ptr, old_ptr, (self.raw_len + 1)
            self.raw = new_raw

    ^@push_str: &Str -> ()
    ^@push_str = text ->
        count = text.len!
        if count == 0
            return
        self.reserve count
        mut ptr = self.raw.ptr!
        source = text.as_ptr!
        unsafe memcpy (ptr + self.raw_len), source, count
        self.raw_len = self.raw_len + count
        unsafe
            ptr[self.raw_len] = 0

    ^@push: Char -> ()
    ^@push = ch ->
        encoded = String::from ch
        self.push_str encoded.as_str!

    ^@pop: Option Char
    ^@pop = ->
        if self.raw_len == 0
            return Option::None
        start = self.raw_len - 1
        while start > 0 && !(str_is_char_boundary self.as_str!, start)
            start = start - 1
        ch = str_char_at_byte self.as_str!, start
        self.truncate start
        Option::Some ch

    ^@clear: ()
    ^@clear = -> self.truncate 0

    // Shortens the string to `len` bytes; `len` must be a UTF-8 boundary.
    ^@truncate: I64 -> ()
    ^@truncate = len ->
        if len < 0 || len >= self.raw_len
            return
        if !(str_is_char_boundary self.as_str!, len)
            puts "string index is not a UTF-8 boundary".as_ptr!
            exit (1 as I32)
        mut ptr = self.raw.ptr!
        self.raw_len = len
        unsafe
            ptr[len] = 0

    // Inserts `text` at byte offset `index`, which must be a UTF-8 boundary.
    ^@insert_str: I64 -> &Str -> ()
    ^@insert_str = index, text ->
        if !(str_is_char_boundary self.as_str!, index)
            puts "string index is not a UTF-8 boundary".as_ptr!
            exit (1 as I32)
        count = text.len!
        if count == 0
            return
        self.reserve count
        mut ptr = self.raw.ptr!
        // Shift the tail (and its NUL) right; the regions overlap, so copy backwards.
        i = self.raw_len + 1
        while i > index
            i = i - 1
            unsafe
                ptr[i + count] = ptr[i]
        source = text.as_ptr!
        unsafe memcpy (ptr + index), source, count
        self.raw_len = self.raw_len + count

// Concatenate two strings, returns new String
impl String
    @concat: String -> String
    @concat = other ->
        new_len = self.raw_len + other.raw_len
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (new_len + 1)
        mut buf = raw.ptr!
        lhs_ptr = self.raw.ptr!
        lhs_len = self.raw_len
        rhs_ptr = other.raw.ptr!
        rhs_len = other.raw_len
        memcpy buf, lhs_ptr, lhs_len
        unsafe
            dest = buf + lhs_len
            memcpy dest, rhs_ptr, rhs_len
            buf[new_len] = 0
        String
            raw: raw
            raw_len: new_len

impl PartialEq String for String
    @== = other -> self.as_str! == other.as_str!

impl PartialEq &Str for String
    @== = other -> self.as_str! == *other

impl PartialEq String for &Str
    @== = other -> *self == other.as_str!

impl Eq for String

// Byte-wise ordering, consistent with `&Str`.
impl Ord for String
    @cmp = other -> self.as_str!.cmp &(other.as_str!)

impl PartialOrd for String
    @partial_cmp = other -> Option::Some (self.cmp other)

impl Hash for String
    @hash = -> self.as_str!.hash!

impl Add String for String
    type Output = String
    @+ = other -> self.concat other

impl Add &Str for String
    type Output = String
    @+ = other -> self.concat (String::from other)

impl Add String for &Str
    type Output = String
    @+ = other -> (String::from *self).concat other

impl Add &Str for &Str
    type Output = String
    @+ = other -> (String::from *self).concat (String::from other)

// Clone
impl Clone for String
    @clone: String
    @clone = ->
        l = self.raw_len
        src = self.raw.ptr!
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (l + 1)
        mut buf = raw.ptr!
        unsafe
            memcpy buf, src, l
            buf[l] = 0
        String
            raw: raw
            raw_len: l

// Drop
impl Drop for String
    ~@drop = -> return
