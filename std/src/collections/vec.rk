// Vec[T] - growable heap-allocated vector

> std::control::option::Option
> std::control::result::Result
> std::mem::alloc::require_non_zero_size
> std::mem::alloc::checked_add_i64
> std::mem::alloc::checked_grow_capacity
> std::mem::utils::sizeof
> std::mem::drop::Drop
> std::mem::drop::drop_in_place
> std::ops::index::Index
> std::ops::index::IndexMut
> std::ops::index::index_bounds_check
> std::ops::index::range_bounds_check
> std::ops::index::borrow_slice_range
> std::ops::index::borrow_slice_range_mut
> std::ops::range::Range
> std::ffi::libc::exit
> std::mem::raw_buffer::RawBuffer
> std::show::Show
> std::functional::callable::FnMut
> std::functional::functor::Functor
> std::functional::applicative::Applicative
> std::functional::monad::Monad
> std::functional::foldable::Foldable
> std::functional::traversable::Traversable
> std::control::control_flow::ControlFlow

< struct Vec T
    raw: RawBuffer T
    raw_len: I64

struct VecTraverseState StateVisitor, StateValue
    < values: Vec StateValue
    < visitor: StateVisitor

vec_traverse_state_new: Vec B -> V -> VecTraverseState V, B
vec_traverse_state_new = values, visitor ->
    VecTraverseState V, B
        values: values
        visitor: visitor

vec_traverse_state_finish: VecTraverseState V, B -> B -> VecTraverseState V, B
vec_traverse_state_finish = mut state, mapped ->
    state.values.push mapped
    state

vec_traverse_visit: V -> A -> (V, R) where V: FnMut A, R
vec_traverse_visit = mut visitor, item ->
    effect: R = visitor item
    (visitor, effect)

vec_traverse_state_values: VecTraverseState V, B -> Vec B
vec_traverse_state_values = state -> state.values

vec_push_owned: Vec T -> T -> Vec T
vec_push_owned = mut values, value ~>
    values.push value
    values

vec_unit: () -> ()
vec_unit = -> return

// Generic Vec T implementation - monomorphized per concrete T
impl Vec T
    @len = -> self.raw_len

    @as_slice: &[T]
    @as_slice = ->
        unsafe self.raw.as_slice self.raw_len

    ^@push = elem ->
        new_len = checked_add_i64 self.raw_len, 1
        if new_len > self.raw.cap!
            old_ptr = self.raw.ptr!
            old_cap = self.raw.cap!
            elem_size = sizeof &elem
            require_non_zero_size elem_size
            new_cap = checked_grow_capacity old_cap
            new_raw = unsafe RawBuffer::with_capacity elem_size, new_cap
            new_ptr = new_raw.ptr!

            i = 0
            while i < self.raw_len
                unsafe *(new_ptr + i) = unsafe *(old_ptr + i)
                i = i + 1

            unsafe *(new_ptr + self.raw_len) = elem
            self.raw = new_raw
        else
            ptr = self.raw.ptr!
            unsafe *(ptr + self.raw_len) = elem

        self.raw_len = new_len

    @get: I64 -> Option &T
    @get = i ->
        if i >= 0 && i < self.raw_len
            ptr = self.raw.ptr!
            unsafe Option::Some (unsafe &ptr[i])
        else
            Option::None

    ^@set: I64 -> T -> ()
    ^@set = i, val ->
        if i >= 0 && i < self.raw_len
            ptr = self.raw.ptr!
            unsafe drop_in_place (ptr + i)
            unsafe *(ptr + i) = val

    ^@swap_remove: I64 -> Option T
    ^@swap_remove = i ->
        if i < 0 || i >= self.raw_len
            Option::None
        else
            ptr = self.raw.ptr!
            value = unsafe *(ptr + i)
            new_len = self.raw_len - 1
            if i != new_len
                unsafe *(ptr + i) = unsafe *(ptr + new_len)
            self.raw_len = new_len
            Option::Some value

    new: () -> Vec T
    new = ->
        Vec T
            raw: RawBuffer::new!
            raw_len: 0

    ~@map: M -> Vec U where M: FnMut T, U
    ~@map = mut mapper ->
        mut source = self
        len = source.raw_len
        ptr = source.raw.ptr!
        source.raw_len = 0
        mut output: Vec U = Vec U
            raw: RawBuffer::new!
            raw_len: 0
        i = 0
        while i < len
            item = unsafe *(ptr + i)
            output.push (mapper item)
            i = i + 1
        output

    @map_ref: M -> Vec U where M: FnMut &T, U
    @map_ref = mut mapper ->
        len = self.raw_len
        ptr = self.raw.ptr!
        mut output: Vec U = Vec U
            raw: RawBuffer::new!
            raw_len: 0
        i = 0
        while i < len
            item = unsafe &ptr[i]
            output.push (mapper item)
            i = i + 1
        output

    @for_each: A -> () where A: FnMut &T, ()
    @for_each = mut action ->
        len = self.raw_len
        ptr = self.raw.ptr!
        i = 0
        while i < len
            item = unsafe &ptr[i]
            action item
            i = i + 1

    ~@for_each_owned: A -> () where A: FnMut T, ()
    ~@for_each_owned = mut action ->
        mut source = self
        len = source.raw_len
        ptr = source.raw.ptr!
        source.raw_len = 0
        i = 0
        while i < len
            item = unsafe *(ptr + i)
            action item
            i = i + 1

    ^@retain: P -> () where P: FnMut &T, Bool
    ^@retain = mut predicate ->
        len = self.raw_len
        ptr = self.raw.ptr!
        self.raw_len = 0
        read = 0
        while read < len
            item = unsafe *(ptr + read)
            if predicate (&item)
                unsafe *(ptr + self.raw_len) = item
                self.raw_len = self.raw_len + 1
            read = read + 1

    ~@filter: P -> Vec T where P: FnMut &T, Bool
    ~@filter = mut predicate ->
        mut source = self
        len = source.raw_len
        ptr = source.raw.ptr!
        source.raw_len = 0
        mut output: Vec T = Vec T
            raw: RawBuffer::new!
            raw_len: 0
        i = 0
        while i < len
            item = unsafe *(ptr + i)
            if predicate (&item)
                output.push item
            i = i + 1
        output

    ~@filter_map: M -> Vec U where M: FnMut T, (Option U)
    ~@filter_map = mut mapper ->
        mut source = self
        len = source.raw_len
        ptr = source.raw.ptr!
        source.raw_len = 0
        mut output: Vec U = Vec U
            raw: RawBuffer::new!
            raw_len: 0
        i = 0
        while i < len
            item = unsafe *(ptr + i)
            mapped: Option U = mapper item
            match mapped
                Option::Some value => output.push value
                Option::None => vec_unit!
            i = i + 1
        output

    ~@try_map: M -> Result (Vec U), E where M: FnMut T, (Result U, E)
    ~@try_map = mut mapper ->
        mut source = self
        len = source.raw_len
        ptr = source.raw.ptr!
        source.raw_len = 0
        mut output: Vec U = Vec U
            raw: RawBuffer::new!
            raw_len: 0
        i = 0
        while i < len
            item = unsafe *(ptr + i)
            mapped: Result U, E = mapper item
            match mapped
                Result::Ok value => output.push value
                Result::Err error =>
                    j = i + 1
                    while j < len
                        unsafe drop_in_place (ptr + j)
                        j = j + 1
                    failure: Result (Vec U), E = Result::Err error
                    return failure
            i = i + 1
        success: Result (Vec U), E = Result::Ok output
        success

    @try_for_each: A -> Result (), E where A: FnMut &T, (Result (), E)
    @try_for_each = mut action ->
        len = self.raw_len
        ptr = self.raw.ptr!
        i = 0
        while i < len
            item = unsafe &ptr[i]
            result: Result (), E = action item
            match result
                Result::Ok unit => vec_unit!
                Result::Err error =>
                    failure: Result (), E = Result::Err error
                    return failure
            i = i + 1
        unit: () = vec_unit!
        success: Result (), E = Result::Ok unit
        success

impl Drop for Vec T
    ~@drop = ->
        i = self.raw_len
        while i > 0
            i = i - 1
            unsafe drop_in_place (self.raw.ptr! + i)
        return

impl Show for Vec T where T: Show
    @show = -> self.as_slice!.show!

impl Index I64 for Vec T
    type Output = T
    @index = i ->
        index_bounds_check i, self.raw_len
        ptr = self.raw.ptr!
        unsafe &ptr[i]

impl IndexMut I64 for Vec T
    type Output = T
    ^@index_mut = i ->
        index_bounds_check i, self.raw_len
        mut ptr = self.raw.ptr!
        unsafe &mut ptr[i]

impl Index Range for Vec T
    type Output = [T]
    @index = range ->
        bounds = range_bounds_check range, self.raw_len
        borrow_slice_range self.raw.ptr!, bounds.0, (bounds.1 - bounds.0)

impl IndexMut Range for Vec T
    type Output = [T]
    ^@index_mut = range ->
        bounds = range_bounds_check range, self.raw_len
        borrow_slice_range_mut self.raw.ptr!, bounds.0, (bounds.1 - bounds.0)

impl Functor for Vec
    fmap = mut mapper, mut value ->
        len = value.raw_len
        ptr = value.raw.ptr!
        value.raw_len = 0
        mut output = Vec::new!
        i = 0
        while i < len
            item = unsafe *(ptr + i)
            output.push (mapper item)
            i = i + 1
        output

impl Foldable for Vec
    try_fold = mut step, initial, mut value ->
        len = value.raw_len
        ptr = value.raw.ptr!
        value.raw_len = 0
        mut output = initial
        i = 0
        while i < len
            item = unsafe *(ptr + i)
            match step (output, item)
                ControlFlow::Continue next => output = next
                ControlFlow::Break result =>
                    j = i + 1
                    while j < len
                        unsafe drop_in_place (ptr + j)
                        j = j + 1
                    stopped: ControlFlow R, B = ControlFlow::Break result
                    return stopped
            i = i + 1
        ControlFlow::Continue output

// Vec intentionally has no Applicative or Monad impl: either Cartesian semantics
// require cloning or zipped semantics violate the list-monad contract.
impl Traversable for Vec
    traverse = mut visitor, mut value ->
        len = value.raw_len
        ptr = value.raw.ptr!
        value.raw_len = 0
        empty: Vec B = Vec::new!
        mut output: G (Vec B) = G::pure empty
        i = 0
        while i < len
            item = unsafe *(ptr + i)
            effect = visitor item
            append = G::ap (G::pure vec_push_owned), output
            output = G::ap append, effect
            i = i + 1
        output

    traverse_m = mut visitor, mut value ->
        len = value.raw_len
        ptr = value.raw.ptr!
        value.raw_len = 0
        empty: Vec B = Vec::new!
        initial_state: VecTraverseState V, B = vec_traverse_state_new empty, visitor
        mut output: G (VecTraverseState V, B) = G::pure initial_state
        i = 0
        while i < len
            item: A = unsafe *(ptr + i)
            step: VecTraverseState V, B -> G (VecTraverseState V, B) = state ->
                visited: (V, G B) = vec_traverse_visit state.visitor, item
                next_state: VecTraverseState V, B = vec_traverse_state_new state.values, visited.0
                finish: B -> VecTraverseState V, B = mapped -> vec_traverse_state_finish next_state, mapped
                wrapped_finish: G (B -> VecTraverseState V, B) = G::pure finish
                G::ap wrapped_finish, visited.1
            output = G::bind output, step
            i = i + 1
        take_values: VecTraverseState V, B -> Vec B = vec_traverse_state_values
        wrapped_take_values: G (VecTraverseState V, B -> Vec B) = G::pure take_values
        G::ap wrapped_take_values, output
