// Eager, ordered traversal for effects without an intermediate collection.

> std::functional::callable::FnMut
> std::functional::foldable::FoldableValue
> std::control::control_flow::ControlFlow
> std::ffi::libc::exit
> std::ffi::libc::puts
> std::ops::range::Range
> std::collections::vec::Vec

for_each: C -> A -> () where C: FoldableValue T, A: FnMut T, ()
< for_each = values, mut action !->
    step: ((), T) -> ControlFlow (), () = pair ->
        action pair.1
        next: ControlFlow (), () = ControlFlow::Continue ()
        next
    values.try_fold step, ()

impl FoldableValue I64 for Range
    ~@try_fold = mut step, initial ->
        state = initial
        match self
            Range::Exclusive start, end =>
                index = start
                while index < end
                    match step (state, index)
                        ControlFlow::Continue next => state = next
                        ControlFlow::Break result =>
                            stopped: ControlFlow R, B = ControlFlow::Break result
                            return stopped
                    index = index + 1
            Range::Inclusive start, end =>
                index = start
                while index <= end
                    match step (state, index)
                        ControlFlow::Continue next => state = next
                        ControlFlow::Break result =>
                            stopped: ControlFlow R, B = ControlFlow::Break result
                            return stopped
                    // Do not increment past the maximum I64 endpoint.
                    if index == end
                        break
                    index = index + 1
            _ =>
                puts "for_each requires a bounded range".as_ptr!
                exit (1 as I32)
        ControlFlow::Continue state

impl FoldableValue &T for &Vec T
    ~@try_fold = step, initial ->
        self.as_slice!.try_fold step, initial

impl FoldableValue &T for &[T]
    ~@try_fold = mut step, initial ->
        len = self.len!
        index = 0
        state = initial
        while index < len
            match step (state, (&self[index]))
                ControlFlow::Continue next => state = next
                ControlFlow::Break result =>
                    stopped: ControlFlow R, B = ControlFlow::Break result
                    return stopped
            index = index + 1
        ControlFlow::Continue state
