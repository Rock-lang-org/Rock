// Process environment access.

> std::string::owned::String
> std::collections::vec::Vec
> std::num::arithmetic::Add
> std::cmp::ord::Ord

extern __rock_runtime_arg_count: () -> I64
extern __rock_runtime_arg_at: I64 -> *U8

// Return an owned snapshot of the program arguments, including argv[0].
args: () -> Vec String
< args = ->
    mut result: Vec String = Vec::new!
    count = __rock_runtime_arg_count!
    i = 0
    while i < count
        ptr = __rock_runtime_arg_at i
        result.push (unsafe String::from_c_str ptr)
        i = i + 1
    result
