// Heap-allocated String type
//
// This is a pure stdlib implementation - NOT a compiler builtin.
// String is a struct that wraps a heap-allocated buffer.

> stdlib::libc::gcvt
> stdlib::libc::memcpy
> stdlib::libc::strlen
> stdlib::libc::puts
> stdlib::libc::exit
> stdlib::clone::Clone
> stdlib::convert::From
> stdlib::drop::Drop
> stdlib::num::Add
> stdlib::raw_buffer::RawBuffer
> stdlib::string::str_as_bytes
> stdlib::string::is_utf8
> stdlib::string::str_char_at
> stdlib::option::Option

// Heap-allocated string type
< struct String
    raw: RawBuffer U8
    raw_len: I64

// Constructor: create empty String (static method)
impl String
    new = ->
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, 1
        unsafe *(raw.ptr!) = 0
        String
            raw: raw
            raw_len: 0

impl From &Str for String
    from = s ->
        slice_len = ~ArrayLen s
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (slice_len + 1)
        mut buf = raw.ptr!
        slice_ptr = ~ArrPtr s
        unsafe
            memcpy buf, slice_ptr, slice_len
            buf[slice_len] = 0

        String
            raw: raw
            raw_len: slice_len

impl From &[U8] for String
    from = bytes ->
        if !(is_utf8 bytes)
            puts (~ArrPtr "invalid UTF-8")
            exit (1 as I32)
        slice_len = ~ArrayLen bytes
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (slice_len + 1)
        mut buf = raw.ptr!
        slice_ptr = ~ArrPtr bytes
        unsafe
            memcpy buf, slice_ptr, slice_len
            buf[slice_len] = 0

        String
            raw: raw
            raw_len: slice_len

impl String
    from_utf8: &[U8] -> Option String
    from_utf8 = bytes ->
        if is_utf8 bytes
            Option::Some (String::from bytes)
        else
            Option::None

    // The pointer must address a valid null-terminated byte string.
    // Invalid UTF-8 is rejected before constructing the owned string.
    unsafe from_c_str: *U8 -> String
    unsafe from_c_str = s ->
        len = strlen s
        bytes = unsafe ~BorrowSlice s, len
        if !(is_utf8 bytes)
            puts (~ArrPtr "invalid UTF-8")
            exit (1 as I32)
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (len + 1)
        mut buf = raw.ptr!
        memcpy buf, s, len
        unsafe buf[len] = 0
        String
            raw: raw
            raw_len: len

impl From I64 for String
    from = x ->
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, 21
        mut buf = raw.ptr!
        is_neg = x < 0
        n = if is_neg
            0 - x
        else
            x

        digits = 1
        temp = n
        while temp >= 10
            temp = temp / 10
            digits = digits + 1

        len = digits
        if is_neg
            len = len + 1

        divisor = 1
        i = 1
        while i < digits
            divisor = divisor * 10
            i = i + 1

        out = 0
        if is_neg
            unsafe *buf = 45
            out = 1

        while divisor > 0
            digit = n / divisor
            unsafe buf[out] = (digit + 48) as U8
            n = n % divisor
            divisor = divisor / 10
            out = out + 1

        unsafe buf[len] = 0
        String
            raw: raw
            raw_len: len

impl From F64 for String
    from = x ->
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, 32
        mut buf = raw.ptr!
        gcvt x, 6, buf
        len = strlen buf
        String
            raw: raw
            raw_len: len

impl From Char for String
    from = c ->
        value = c as I64
        if value > 1114111 || (value >= 55296 && value <= 57343)
            puts (~ArrPtr "invalid Unicode scalar")
            exit (1 as I32)
        len = if value < 128 then 1 else if value < 2048 then 2 else if value < 65536 then 3 else 4
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (len + 1)
        mut buf = raw.ptr!
        unsafe
            if len == 1
                *buf = value as U8
            else
                remaining = value
                i = len - 1
                while i > 0
                    buf[i] = (128 + remaining % 64) as U8
                    remaining = remaining / 64
                    i = i - 1
                prefix = if len == 2 then 192 else if len == 3 then 224 else 240
                *buf = (prefix + remaining) as U8
            buf[len] = 0
        String
            raw: raw
            raw_len: len

// Get raw pointer for libc interop
impl String
    @len = -> self.raw_len

    @as_ptr = -> self.raw.ptr!

    @as_str: &Str
    @as_str = -> unsafe ~BorrowStr self.raw.ptr!, self.raw_len

    @as_bytes: &[U8]
    @as_bytes = -> str_as_bytes self.as_str!

    @char_at: I64 -> Option Char
    @char_at = index -> str_char_at self.as_str!, index

// Concatenate two strings, returns new String
impl String
    @concat: String -> String
    @concat = other ->
        new_len = self.raw_len + other.raw_len
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (new_len + 1)
        mut buf = raw.ptr!
        lhs_ptr = self.raw.ptr!
        lhs_len = self.raw_len
        rhs_ptr = other.raw.ptr!
        rhs_len = other.raw_len
        memcpy buf, lhs_ptr, lhs_len
        unsafe
            dest = buf + lhs_len
            memcpy dest, rhs_ptr, rhs_len
            buf[new_len] = 0
        String
            raw: raw
            raw_len: new_len

impl Add String for String
    type Output = String
    @+ = other -> self.concat other

impl Add &Str for String
    type Output = String
    @+ = other -> self.concat (String::from other)

impl Add String for &Str
    type Output = String
    @+ = other -> (String::from *self).concat other

impl Add &Str for &Str
    type Output = String
    @+ = other -> (String::from *self).concat (String::from other)

// Clone
impl Clone for String
    @clone: String
    @clone = ->
        l = self.raw_len
        src = self.raw.ptr!
        raw: RawBuffer U8 = unsafe RawBuffer::with_capacity 1, (l + 1)
        mut buf = raw.ptr!
        unsafe
            memcpy buf, src, l
            buf[l] = 0
        String
            raw: raw
            raw_len: l

// Drop
impl Drop for String
    ~@drop = -> return
