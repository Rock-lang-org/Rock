// Callable trait hierarchy.
//
// FnOnce consumes its callable, FnMut permits mutation, and Fn permits
// shared invocation. Each trait keeps its canonical Output member so the
// compiler can validate and transport the callable protocol by ID.

lang fn_once
< trait FnOnce Args, Ret
    lang output
    type Output
    lang method
    ~@call_once: Args -> Ret

lang fn_mut
< trait FnMut Args, Ret where Self: FnOnce Args, Ret
    lang output
    type Output
    lang method
    ^@call_mut: Args -> Ret

lang fn
< trait Fn Args, Ret where Self: FnMut Args, Ret
    lang output
    type Output
    lang method
    @call: Args -> Ret

impl FnOnce Args, Ret for &F where F: Fn Args, Ret
    type Output = Ret
    ~@call_once = args -> (*self) args

impl FnMut Args, Ret for &F where F: Fn Args, Ret
    type Output = Ret
    ^@call_mut = args -> (*self) args

impl Fn Args, Ret for &F where F: Fn Args, Ret
    type Output = Ret
    @call = args -> (*self) args

impl FnOnce Args, Ret for &mut F where F: FnMut Args, Ret
    type Output = Ret
    ~@call_once = args -> (*self) args

impl FnMut Args, Ret for &mut F where F: FnMut Args, Ret
    type Output = Ret
    ^@call_mut = args -> (*self) args

impl Fn Args, Ret for &mut F where F: Fn Args, Ret
    type Output = Ret
    @call = args -> (*self) args
