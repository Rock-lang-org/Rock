// Shared ownership keeps allocation/count state independent of the pointee.
> stdlib::alloc::Global
> stdlib::alloc::Layout
> stdlib::alloc::checked_alloc
> stdlib::atomic::AtomicU64
> stdlib::clone::Clone
> stdlib::deref::Deref
> stdlib::drop::Drop
> stdlib::drop::drop_in_place
> stdlib::libc::exit
> stdlib::sized::Sized
> stdlib::object_owner::ObjectOwner
> stdlib::object_owner::ObjectOwnerAllocate

< struct ArcHeader
    < refs: AtomicU64
    < base: *U8
    < bytes: I64
    < alignment: I64

< struct Arc (T: ?Sized)
    payload: *T
    header: *ArcHeader

allocate_arc: I64 -> I64 -> (*U8, *ArcHeader)
allocate_arc = bytes, alignment ->
    layout = Layout
        size: bytes
        align: alignment
    base = checked_alloc layout
    state = ArcHeader
        refs: AtomicU64::new (1 as U64)
        base: base
        bytes: bytes
        alignment: alignment
    header_layout = Layout
        size: ~SizeOf state
        align: ~AlignOf state
    header = (checked_alloc header_layout) as *ArcHeader
    unsafe *header = state
    (base, header)

impl Arc T
    new: T -> Arc T
    new = value ->
        parts = allocate_arc (~SizeOf value), (~AlignOf value)
        pointer: *T = parts.0 as *T
        unsafe *pointer = value
        Arc T
            payload: pointer
            header: parts.1

impl Clone for Arc T where T: ?Sized
    @clone = ->
        refs = unsafe &(*self.header).refs
        previous = refs.fetch_add (1 as U64)
        if ~U64Eq previous, (~U64Not (0 as U64))
            exit (1 as I32)
        Arc T
            payload: self.payload
            header: self.header

impl Deref for Arc T where T: ?Sized
    type Target = T
    @* = -> unsafe &*self.payload

impl Drop for Arc T where T: ?Sized
    ~@drop = !->
        refs = unsafe &(*self.header).refs
        previous = refs.fetch_sub (1 as U64)
        if ~U64Eq previous, (1 as U64)
            base = unsafe (*self.header).base
            layout = Layout
                size: unsafe (*self.header).bytes
                align: unsafe (*self.header).alignment
            header_layout = Layout
                size: ~SizeOf (unsafe *self.header)
                align: ~AlignOf (unsafe *self.header)
            unsafe drop_in_place self.payload
            unsafe Global::dealloc base, layout
            unsafe drop_in_place self.header
            unsafe Global::dealloc (self.header as *U8), header_layout

impl ObjectOwner (*ArcHeader) for Arc
    unsafe into_parts = owner ->
        parts = (owner.payload, owner.header)
        ~Forget owner
        parts
    unsafe from_parts = pointer, state -> Arc
        payload: pointer
        header: state

impl ObjectOwnerAllocate (*ArcHeader) for Arc
    unsafe allocate = bytes, alignment -> allocate_arc bytes, alignment
