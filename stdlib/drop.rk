// Drop trait - provides RAII cleanup
//
// Types that implement this trait will have `~@drop` called automatically
// when they go out of scope.

lang drop
< trait Drop
    lang method
    ~@drop: ()

> stdlib::sized::Sized

unsafe drop_in_place: *T -> () where T: ?Sized
< unsafe drop_in_place = ptr -> unsafe ~DropInPlace ptr
