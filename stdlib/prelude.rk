// Rock Prelude
//
// All items exported here are automatically available in every Rock program
// without explicit imports. To add something to the prelude, add a re-export
// line: `< full::qualified::path` or `< module::path::*` to re-export all items.

// I/O and Math (selective from libc - not all C functions should be in prelude)
< stdlib::libc::puts
< stdlib::libc::exit
< stdlib::libc::sqrt
< stdlib::libc::sin
< stdlib::libc::cos
< stdlib::libc::tan
< stdlib::libc::asin
< stdlib::libc::acos
< stdlib::libc::atan
< stdlib::libc::exp
< stdlib::libc::log
< stdlib::libc::log2
< stdlib::libc::log10
< stdlib::libc::ceil
< stdlib::libc::floor
< stdlib::libc::round
< stdlib::libc::abs_f64
< stdlib::libc::fabs
< stdlib::libc::pow
< stdlib::libc::atan2
< stdlib::libc::strlen
< stdlib::libc::strcmp

// String, conversion, utility, memory - re-export all exported items
< stdlib::string::*
< stdlib::convert::*
< stdlib::util::*
< stdlib::mem::*
< stdlib::fp::|>
< stdlib::io::|>>

// Types
< stdlib::string_type::*
< stdlib::option::*
< stdlib::result::*
< stdlib::box_type::Box
< stdlib::arc::Arc
< stdlib::sync::Mutex
< stdlib::sync::MutexGuard
< stdlib::vec::*
< stdlib::hash_map::*
< stdlib::slice::slice_len

// Traits
< stdlib::show::*
< stdlib::deref::*
< stdlib::index::Index
< stdlib::index::IndexMut
< stdlib::range::Range
< stdlib::ops::*
< stdlib::callable::*
< stdlib::bifunctor::Bifunctor
< stdlib::bifunctor::bimap
< stdlib::bifunctor::<!>
< stdlib::functor::*
< stdlib::functor::<$>
< stdlib::functor::<&>
< stdlib::applicative::*
< stdlib::applicative::<*>
< stdlib::monad::*
< stdlib::monad::>>=
< stdlib::foldable::*
< stdlib::for_each::*
< stdlib::traversable::*
< stdlib::thread_safety::*
< stdlib::clone::*
< stdlib::drop::*
< stdlib::num::*
< stdlib::ord::*
< stdlib::eq::*
< stdlib::hash::*
< stdlib::bitwise::*
< stdlib::neg::*
< stdlib::not::*
< stdlib::sized::*
