// Owned POSIX threads with Rust-style spawn and join semantics.

> stdlib::alloc::Global
> stdlib::alloc::Layout
> stdlib::alloc::checked_alloc
> stdlib::atomic::AtomicU64
> stdlib::callable::FnOnce
> stdlib::drop::Drop
> stdlib::drop::drop_in_place
> stdlib::libc::pthread_create
> stdlib::libc::pthread_detach
> stdlib::libc::pthread_join
> stdlib::libc::pthread_self
> stdlib::libc::sched_yield
> stdlib::libc::usleep
> stdlib::mem::forget
> stdlib::result::Result
> stdlib::thread_safety::Send

thread_unit = -> return

< enum ThreadError
    CreateFailed I32
    JoinFailed I32

struct ThreadState T
    < refs: AtomicU64
    < result: *T
    < result_bytes: I64
    < env: *U8
    < env_bytes: I64

< struct ThreadPacket F, T
    task: F
    state: *ThreadState T

< struct JoinHandle T
    thread: U64
    state: *ThreadState T
    joined: Bool

impl ThreadPacket F, T where F: FnOnce (), T
    new: F -> *ThreadState T -> ThreadPacket F, T
    new = task, state ->
        ThreadPacket F, T
            task: task
            state: state

    ~@run: *U8
    ~@run = ->
        value = self.task!
        result = unsafe (*self.state).result
        unsafe *result = value
        thread_state_release_detached self.state
        0 as *U8

impl JoinHandle T
    new: U64 -> *ThreadState T -> JoinHandle T
    new = thread, state ->
        JoinHandle T
            thread: thread
            state: state
            joined: false

unsafe callable_word: &(() -> *U8) -> I64 -> U64
unsafe callable_word = callable, index ->
    words = callable as *U64
    unsafe *(~PtrOffset words, index)

free_env: *U8 -> I64 -> ()
free_env = env, bytes ->
    layout = Layout
        size: bytes
        align: 1
    unsafe Global::dealloc env, layout

thread_state_new: *T -> I64 -> *ThreadState T
thread_state_new = result, result_bytes ->
    null = 0 as *ThreadState T
    state_bytes = ~SizeOf (unsafe *null)
    layout = Layout
        size: state_bytes
        align: 1
    state = (checked_alloc layout) as *ThreadState T
    unsafe *state = ThreadState T
        refs: AtomicU64::new (2 as U64)
        result: result
        result_bytes: result_bytes
        env: 0 as *U8
        env_bytes: 0
    state

thread_state_set_env: *ThreadState T -> *U8 -> I64 -> ()
thread_state_set_env = state, env, env_bytes ->
    unsafe (*state).env = env
    unsafe (*state).env_bytes = env_bytes
    return

thread_state_cleanup: *ThreadState T -> Bool -> ()
thread_state_cleanup = state, drop_result ->
    result = unsafe (*state).result
    result_bytes = unsafe (*state).result_bytes
    env = unsafe (*state).env
    env_bytes = unsafe (*state).env_bytes
    state_bytes = ~SizeOf (unsafe *state)
    if drop_result
        unsafe drop_in_place result
    unsafe drop_in_place state
    free_env (result as *U8), result_bytes
    free_env env, env_bytes
    free_env (state as *U8), state_bytes

thread_state_release_detached: *ThreadState T -> ()
thread_state_release_detached = state ->
    refs = unsafe &(*state).refs
    previous = refs.fetch_sub (1 as U64)
    if ~U64Eq previous, (1 as U64)
        thread_state_cleanup state, true
    return

thread_state_release_joined: *ThreadState T -> ()
thread_state_release_joined = state ->
    refs = unsafe &(*state).refs
    previous = refs.fetch_sub (1 as U64)
    if ~U64Eq previous, (1 as U64)
        thread_state_cleanup state, false
    return

spawn: F -> Result (JoinHandle T), ThreadError where F: Send, T: Send, F: FnOnce (), T
< spawn = task ->
    null_result = 0 as *T
    result_size = ~SizeOf (unsafe *null_result)
    result_bytes = if result_size == 0
        1
    else
        result_size
    result_layout = Layout
        size: result_bytes
        align: 1
    result = (checked_alloc result_layout) as *T
    state = thread_state_new result, result_bytes

    packet = ThreadPacket::new task, state
    env_bytes = ~SizeOf packet
    runner = -> packet.run!
    code_word = unsafe callable_word (&runner), 0
    env_word = unsafe callable_word (&runner), 1
    code = code_word as *U8
    env = env_word as *U8
    thread_state_set_env state, env, env_bytes
    null = 0 as *U8
    mut thread = 0 as U64
    status = pthread_create ((&mut thread) as *U64), null, code, env
    if ~I32Eq status, 0
        forget runner
        Result::Ok (JoinHandle::new thread, state)
    else
        unsafe drop_in_place (env as *ThreadPacket F, T)
        thread_state_cleanup state, false
        forget runner
        Result::Err (ThreadError::CreateFailed status)

spawn_detached: F -> Result (), ThreadError where F: Send, F: FnOnce (), ()
< spawn_detached = task ->
    started: Result (JoinHandle ()), ThreadError = spawn task
    match started
        Result::Ok handle => Result::Ok (thread_unit!)
        Result::Err error => Result::Err error

impl JoinHandle T
    ~@join: Result T, ThreadError
    ~@join = ->
        mut env = 0 as U64
        status = pthread_join self.thread, ((&mut env) as *U64)
        if ~I32Eq status, 0
            self.joined = true
            output_ptr = unsafe (*self.state).result
            joined = Result::Ok (unsafe *output_ptr)
            thread_state_release_joined self.state
            joined
        else
            Result::Err (ThreadError::JoinFailed status)

impl Drop for JoinHandle T
    ~@drop = ->
        if !self.joined
            status = pthread_detach self.thread
            thread_state_release_detached self.state
        return

current_id: () -> U64
< current_id = -> pthread_self!

yield_now: () -> ()
< yield_now = ->
    status = sched_yield!
    return

sleep_ms: I64 -> ()
< sleep_ms = milliseconds ->
    if ~I64Le milliseconds, 0
        return
    micros = milliseconds * 1000
    status = usleep (micros as U32)
    return
