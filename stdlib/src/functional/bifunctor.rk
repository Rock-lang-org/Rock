// Bifunctor maps independently over both arguments of a binary type constructor.

> stdlib::functional::callable::FnMut

< trait Bifunctor for F _, _
    bimap: M -> N -> F A, C -> F B, D where M: FnMut A, B, N: FnMut C, D

bifunctor_identity: A -> A
bifunctor_identity = value -> value

bimap: (A -> B) -> (C -> D) -> F A, C -> F B, D where F _, _: Bifunctor
< bimap = map_first, map_second, value ->
    F::Bifunctor::bimap map_first, map_second, value

first: (A -> B) -> F A, C -> F B, C where F _, _: Bifunctor
< first = mapper, value ->
    F::Bifunctor::bimap mapper, bifunctor_identity, value

second: (C -> D) -> F A, C -> F A, D where F _, _: Bifunctor
< second = mapper, value ->
    F::Bifunctor::bimap bifunctor_identity, mapper, value

<!>: F A, C -> (C -> D) -> F A, D where F _, _: Bifunctor
<!> = value, mapper ->
    F::Bifunctor::bimap bifunctor_identity, mapper, value
