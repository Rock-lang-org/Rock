// Memory utilities
//
// Provides the `size_of` free function that returns the byte size of a value.
// Uses the ~SizeOf compiler intrinsic which queries LLVM for accurate sizing.

< size_of = val -> ~SizeOf val

// Deliberately suppress destruction of a value. This is safe but may leak
// resources, matching Rust's mem::forget contract.
forget: T -> ()
< forget = value -> ~Forget value
