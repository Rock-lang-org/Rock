// Ord trait - provides ordering comparison operators

< trait Ord
    @<: &Self -> Bool
    @<=: &Self -> Bool
    @>: &Self -> Bool
    @>=: &Self -> Bool

impl Ord for I64
    @< = other -> ~I64Lt *self, *other
    @<= = other -> ~I64Le *self, *other
    @> = other -> ~I64Gt *self, *other
    @>= = other -> ~I64Ge *self, *other

impl Ord for I32
    @< = other -> ~I32Lt *self, *other
    @<= = other -> ~I32Le *self, *other
    @> = other -> ~I32Gt *self, *other
    @>= = other -> ~I32Ge *self, *other

impl Ord for F64
    @< = other -> ~F64Lt *self, *other
    @<= = other -> ~F64Le *self, *other
    @> = other -> ~F64Gt *self, *other
    @>= = other -> ~F64Ge *self, *other

impl Ord for F32
    @< = other -> ~F32Lt *self, *other
    @<= = other -> ~F32Le *self, *other
    @> = other -> ~F32Gt *self, *other
    @>= = other -> ~F32Ge *self, *other
