// Neg trait - unary numeric or custom negation with an associated output type.

< trait Neg
    type Output
    @-: Self::Output

impl Neg for I64
    type Output = I64
    @- = -> ~I64Neg *self

impl Neg for I32
    type Output = I32
    @- = -> ~I32Neg *self

impl Neg for F64
    type Output = F64
    @- = -> ~F64Neg *self

impl Neg for F32
    type Output = F32
    @- = -> ~F32Neg *self
