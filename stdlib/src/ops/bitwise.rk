// Bitwise trait - provides bitwise operations for integer types

< trait Bitwise
    @|: Self -> Self
    @^: Self -> Self
    @&: Self -> Self
    @<<: Self -> Self
    @>>: Self -> Self

impl Bitwise for I64
    @| = other -> ~I64Or *self, other
    @^ = other -> ~I64Xor *self, other
    @& = other -> ~I64And *self, other
    @<< = other -> ~I64Shl *self, other
    @>> = other -> ~I64Shr *self, other

impl Bitwise for I32
    @| = other -> ~I32Or *self, other
    @^ = other -> ~I32Xor *self, other
    @& = other -> ~I32And *self, other
    @<< = other -> ~I32Shl *self, other
    @>> = other -> ~I32Shr *self, other

impl Bitwise for I16
    @| = other -> ~I16Or *self, other
    @^ = other -> ~I16Xor *self, other
    @& = other -> ~I16And *self, other
    @<< = other -> ~I16Shl *self, other
    @>> = other -> ~I16Shr *self, other

impl Bitwise for I8
    @| = other -> ~I8Or *self, other
    @^ = other -> ~I8Xor *self, other
    @& = other -> ~I8And *self, other
    @<< = other -> ~I8Shl *self, other
    @>> = other -> ~I8Shr *self, other

impl Bitwise for U64
    @| = other -> ~U64Or *self, other
    @^ = other -> ~U64Xor *self, other
    @& = other -> ~U64And *self, other
    @<< = other -> ~U64Shl *self, other
    @>> = other -> ~U64Shr *self, other

