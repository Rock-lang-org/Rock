// Hash trait - provides stable integer hashes for hash-table keys.

< trait Hash
    @hash: I64

impl Hash for I64
    @hash = -> *self

impl Hash for I32
    @hash = -> *self as I64

impl Hash for Bool
    @hash = ->
        if *self
            1
        else
            0

impl Hash for Char
    @hash = -> *self as I64

impl Hash for &Str
    @hash = ->
        value = *self
        ptr = ~ArrPtr value
        len = ~ArrayLen value
        h = 5381
        i = 0
        while i < len
            byte = unsafe ptr[i]
            h = ((h * 33) + (byte as I64)) % 2147483647
            i = i + 1
        h
