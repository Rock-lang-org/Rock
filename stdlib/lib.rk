// Rock Standard Library
//
// This is the main entry point for the standard library.
// It declares modules that contain the actual implementations.
//
// Module organization:
// - math: Mathematical functions (sqrt, sin, cos, etc.)
// - io: I/O functions (puts, exit)
// - string: String manipulation (strlen, strcmp, atoi)
// - string_type: Heap-allocated String struct
// - convert: Type conversion (to_float, to_int, etc.)
// - util: Utility functions (abs, min, max)
// - env: Process environment and program arguments
//
// Note: println is a trait method from the Show trait.
// Use ~ArrayLen intrinsic to get array length. Arrays are immutable slices.
// Use Vec for growable mutable arrays.

// ============================================================================
// Operator precedence declarations (higher = binds tighter)
// ALL operators must be declared here - no hardcoded defaults
// ============================================================================
infix 1 ||
infix 1 |>
infix 1 |>>
infix 2 &&
infix 3 |
infix 4 ^
infix 5 &
infix 6 ==
infix 6 !=
infix 7 <
infix 7 <=
infix 7 >
infix 7 >=
infix 8 <<
infix 8 >>
infix 8 >>=
infix 9 +
infix 9 -
infix 8 <|>
infix 8 <$>
infix 8 <&>
infix 8 <*>
infix 8 <!>
infix 8 !>
infix 10 *
infix 10 /
infix 10 %

// libc module - all C standard library extern declarations
< mod libc

// Memory management and Allocator API
< mod alloc

// RAII Drop Trait
< mod drop

// Raw heap storage and owned heap values
< mod raw_buffer
< mod box_type

// Sized module - compile-time element size marker trait
< mod sized

// Num module - arithmetic trait and implementations
< mod num

// Ord module - ordering comparison trait and implementations
< mod ord

// Eq module - equality comparison trait and implementations
< mod eq

// Clone module - explicit deep copy trait and implementations (must come before show)
< mod clone

// String type - heap-allocated String struct (must come early so String is defined)
< mod string_type

// Convert module - type conversion functions
< mod convert

// Util module - utility functions
< mod util

// Hash module - hashing trait and implementations
< mod hash

// Bitwise module - bitwise trait and implementations
< mod bitwise

// Neg and Not modules - unary operator traits
< mod neg
< mod not

// Mem module - memory utilities (size_of, etc.)
< mod mem

// Show module - string representation trait and implementations
< mod show

// Deref trait - dereferencing with an associated target type
< mod deref

// First-class native range values
< mod range

// Index trait - indexing with associated output type
< mod index

// Safe borrowed-slice operations
< mod slice

// Functional helpers and generic operators
< mod fp

// Generic control-flow carrier traits
< mod ops

// Callable trait hierarchy
< mod callable

// Higher-kinded functional abstractions
< mod bifunctor
< mod functor
< mod applicative
< mod monad
< mod foldable
< mod traversable

// Vec module - growable heap-allocated vector
< mod vec

// Generic eager traversal over ranges and owned or borrowed collections
< mod for_each

// String module - string manipulation functions
< mod string

// Shared ownership and synchronization primitives
mod atomic
< mod arc
< mod sync

// Thread-safety marker traits
< mod thread_safety

// Option module - optional value type
< mod option

// Result module - success or failure value type
< mod result

// Process environment and program arguments
< mod env

// IO traits and error type
< mod io

// File manipulation primitives
< mod fs

// HashMap module - hash-table map
< mod hash_map

// Net module - blocking IPv4 TCP networking
< mod net

// Safe owned operating-system threads
< mod thread

// Prelude module - re-exports of all items available without qualification
mod prelude
