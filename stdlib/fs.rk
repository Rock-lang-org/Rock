// File manipulation API backed by POSIX descriptors.

> stdlib::drop::Drop
> stdlib::io::IoError
> stdlib::io::Read
> stdlib::io::Write
> stdlib::io::last_os_error
> stdlib::io::write_all
> stdlib::io::write_str
> stdlib::libc::close
> stdlib::libc::open
> stdlib::libc::read
> stdlib::libc::write
> stdlib::result::Result
> stdlib::string_type::String

< struct File
    fd: I32

// Linux open(2) flags remain private backend details.
o_rdonly = -> 0
o_wronly = -> 1
o_creat = -> 64
o_trunc = -> 512
o_append = -> 1024
default_mode = -> 438

path_has_nul: &Str -> Bool
path_has_nul = path ->
    ptr = ~ArrPtr path
    len = ~ArrayLen path
    i = 0
    while i < len
        if (unsafe ptr[i]) == (0 as U8)
            return true
        i = i + 1
    false

file_from_fd: I32 -> File
file_from_fd = fd ->
    unsafe *((&fd) as *File)

open_with_flags: &Str -> I32 -> Result File, IoError
open_with_flags = path, flags ->
    if path_has_nul path
        err = IoError::InvalidPath
        Result::Err err
    else
        owned_path = String::from path
        fd = open owned_path.as_ptr!, flags, default_mode!
        if fd < (0 as I32)
            Result::Err (last_os_error!)
        else
            Result::Ok (file_from_fd fd)

impl File
    open: &Str -> Result File, IoError
    open = path ->
        open_with_flags path, o_rdonly!

    create: &Str -> Result File, IoError
    create = path ->
        open_with_flags path, ((o_wronly!) | (o_creat!) | (o_trunc!))

    append: &Str -> Result File, IoError
    append = path ->
        open_with_flags path, ((o_wronly!) | (o_creat!) | (o_append!))

impl Read for File
    ^@read: &mut [U8] -> Result I64, IoError
    ^@read = buf ->
        count = read self.fd, (~ArrPtr *buf), (~ArrayLen *buf)
        if count < 0
            Result::Err (last_os_error!)
        else
            Result::Ok count

impl Write for File
    @write: &[U8] -> Result I64, IoError
    @write = buf ->
        count = write self.fd, (~ArrPtr buf), (~ArrayLen buf)
        if count < 0
            Result::Err (last_os_error!)
        else
            Result::Ok count

    @write_str = value -> write_str self, value
    @write_all = buf -> write_all self, buf

impl Drop for File
    ~@drop = ->
        closed = close self.fd
        return
