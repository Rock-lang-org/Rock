
> stdlib::libc::free
> stdlib::libc::posix_memalign
> stdlib::libc::memcpy
> stdlib::libc::exit

< struct Layout
    < size: I64
    < align: I64

< struct Global

impl Global
    unsafe alloc: Layout -> *U8
    unsafe alloc = layout ->
        if layout.size < 0 || layout.align <= 0
            exit (1 as I32)
        if (~I64And layout.align, (layout.align - 1)) != 0
            exit (1 as I32)
        // POSIX requires pointer-sized alignment; zero-sized owners still get
        // a unique, aligned allocation which free can release normally.
        pointer_alignment = ~SizeOf (0 as *U8)
        alignment = if layout.align < pointer_alignment then pointer_alignment else layout.align
        bytes = if layout.size == 0 then 1 else layout.size
        mut pointer: *U8 = 0 as *U8
        result = posix_memalign ((&mut pointer) as *(*U8)), alignment, bytes
        if result != (0 as I32)
            0 as *U8
        else
            pointer
    unsafe dealloc: *U8 -> Layout -> ()
    unsafe dealloc = ptr, layout -> free ptr
    unsafe realloc: *U8 -> Layout -> I64 -> *U8
    unsafe realloc = ptr, old_layout, new_size ->
        layout = Layout
            size: new_size
            align: old_layout.align
        replacement = Global::alloc layout
        if (replacement as I64) == 0
            return replacement
        count = if old_layout.size < new_size then old_layout.size else new_size
        if count > 0 && (ptr as I64) != 0
            memcpy replacement, ptr, count
        Global::dealloc ptr, old_layout
        replacement

require_non_zero_size: I64 -> ()
< require_non_zero_size = size ->
    if size == 0
        exit (1 as I32)

checked_add_i64: I64 -> I64 -> I64
< checked_add_i64 = a, b ->
    result = a + b
    if b > 0 && result < a
        exit (1 as I32)
    if b < 0 && result > a
        exit (1 as I32)
    result

checked_mul_i64: I64 -> I64 -> I64
< checked_mul_i64 = a, b ->
    if a < 0 || b < 0
        exit (1 as I32)
    if a != 0
        result = a * b
        if (result / a) != b
            exit (1 as I32)
        result
    else
        0

checked_grow_capacity: I64 -> I64
< checked_grow_capacity = old_cap ->
    if old_cap == 0
        4
    else
        checked_mul_i64 old_cap, 2

checked_alloc: Layout -> *U8
< checked_alloc = layout ->
    ptr = unsafe Global::alloc layout
    if (ptr as I64) == 0
        exit (1 as I32)
    ptr
