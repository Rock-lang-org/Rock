// A library-owned, token-preserving type tree; no compiler AST or semantics.
> rock_macro::*
> rock_syntax::*
> rock_syntax::cursor::Cursor
> std::collections::vec::Vec
> std::control::option::Option
> std::control::result::Result
> std::clone::Clone
> std::convert::From
> std::string::owned::String
> std::num::arithmetic::Add
> std::num::arithmetic::Sub
> std::num::arithmetic::Mul
> std::cmp::eq::PartialEq
> std::cmp::ord::PartialOrd
> std::ops::index::Index
> std::ops::not::Not

< struct TypeLimits
    < max_depth: I64
    < max_nodes: I64

impl TypeLimits
    standard: TypeLimits
    standard = -> TypeLimits
        max_depth: 128
        max_nodes: 65536

< enum TypeKind
    Name
    Associated
    Application
    SharedReference
    MutableReference
    Pointer
    Unit
    Grouped
    Tuple
    Slice
    Array
    ArrayLength U64
    Hole
    Function

< struct TypeNode
    < kind: TypeKind
    < range: ByteRange
    < children: Vec I64
    < context: Option SyntaxContext

// Flat postorder storage keeps destruction nonrecursive. Child indices are
// earlier than their parent; grouping remains explicit for lossless consumers.
< struct TypeSyntax
    stream: TokenStream
    arena: Vec TypeNode
    root_index: I64

struct Lexeme
    < token: Token
    < text: String

struct Parser
    < lexer_cursor: Cursor
    < lexemes: Vec Lexeme
    < arena: Vec TypeNode
    < lexeme_index: I64
    < last_end: U64
    < limits: TypeLimits

impl TypeSyntax
    parse: TokenStream -> Result TypeSyntax, ParseError
    parse = input -> TypeSyntax::parse_with_limits input, Limits::standard!, TypeLimits::standard!

    parse_with_limits: TokenStream -> Limits -> TypeLimits -> Result TypeSyntax, ParseError
    parse_with_limits = input, lexical_limits, limits ->
        if limits.max_depth < 0 || limits.max_depth > 128 || limits.max_nodes < 0 || limits.max_nodes > 65536
            failure: Result TypeSyntax, ParseError = Result::Err (ParseError::at ParseErrorKind::InvalidLimits, 0, 0)
            return failure
        mut cursor = Cursor::with_limits input, lexical_limits ?
        mut lexemes: Vec Lexeme = Vec::new!
        loop
            match cursor.next_token! ?
                Option::None => break
                Option::Some token =>
                    text = cursor.spelling &token ?
                    lexemes.push (Lexeme
                        token: token
                        text: text)
        mut parser = Parser
            lexer_cursor: cursor
            lexemes: lexemes
            arena: Vec::new!
            lexeme_index: 0
            last_end: 0
            limits: limits
        root = parser.read_type 0 ?
        if parser.lexeme_index < parser.lexemes.len!
            failure: Result TypeSyntax, ParseError = Result::Err (parser.failure ParseErrorKind::TrailingTypeTokens)
            return failure
        Result::Ok (TypeSyntax
            stream: parser.lexer_cursor.input!.clone!
            arena: parser.arena
            root_index: root)

    @nodes: &Vec TypeNode
    @nodes = -> &self.arena

    @root: I64
    @root = -> self.root_index

    @original: &TokenStream
    @original = -> &self.stream

    // C.04 emission supports unchanged nodes only: preserve, never print ASTs.
    @emit: TokenStream
    @emit = -> self.stream.clone!

    @node_tokens: I64 -> Result TokenStream, ParseError
    @node_tokens = index ->
        if index < 0 || index >= self.arena.len!
            failure: Result TokenStream, ParseError = Result::Err (ParseError::at (ParseErrorKind::InvalidTypeNode index), 0, 0)
            return failure
        match self.stream.slice (self.arena[index].range.clone!)
            Result::Ok tokens => Result::Ok tokens
            Result::Err error => Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), 0, 0)

impl TypeKind
    @tag: &Str
    @tag = ->
        match *self
            TypeKind::Name => "name"
            TypeKind::Associated => "path"
            TypeKind::Application => "apply"
            TypeKind::SharedReference => "ref"
            TypeKind::MutableReference => "mut-ref"
            TypeKind::Pointer => "pointer"
            TypeKind::Unit => "unit"
            TypeKind::Grouped => "group"
            TypeKind::Tuple => "tuple"
            TypeKind::Slice => "slice"
            TypeKind::Array => "array"
            TypeKind::ArrayLength value => "length"
            TypeKind::Hole => "hole"
            TypeKind::Function => "function"

impl Parser
    @failure: ParseErrorKind -> ParseError
    @failure = kind ->
        if self.lexeme_index < self.lexemes.len!
            token = &self.lexemes[self.lexeme_index].token
            return ParseError::at kind, (token.range.start), (token.range.end)
        offset = self.lexer_cursor.byte_offset!
        ParseError::at kind, offset, offset

    @at: &Str -> Bool
    @at = text ->
        if self.lexeme_index >= self.lexemes.len!
            return false
        item = &self.lexemes[self.lexeme_index]
        tag = item.token.tag!
        (tag == "symbol" || tag == "operator" || tag == "stuck-operator" || tag == "keyword") && item.text == text

    @is_name: I64 -> Bool
    @is_name = index -> index < self.lexemes.len! && self.lexemes[index].token.tag! == "type"

    @starts_atom: I64 -> Bool
    @starts_atom = index ->
        if index >= self.lexemes.len!
            return false
        item = &self.lexemes[index]
        tag = item.token.tag!
        tag == "type" || (tag == "symbol" && (item.text == "_" || item.text == "(" || item.text == "[" || item.text == "&")) || (tag == "stuck-operator" && item.text == "*")

    @where_subject: I64 -> Bool
    @where_subject = index ->
        if !(self.is_name index) || index + 1 >= self.lexemes.len!
            return false
        if self.lexemes[index + 1].text == ":"
            return true
        index + 2 < self.lexemes.len! && self.lexemes[index + 1].text == "_" && self.lexemes[index + 2].text == ":"

    ^@take: Result I64, ParseError
    ^@take = ->
        if self.lexeme_index >= self.lexemes.len!
            failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedType)
            return failure
        index = self.lexeme_index
        self.lexeme_index = self.lexeme_index + 1
        self.last_end = self.lexemes[index].token.range.end
        Result::Ok index

    ^@add: TypeKind -> U64 -> Vec I64 -> Option SyntaxContext -> Result I64, ParseError
    ^@add = kind, start, children, context ->
        end = self.last_end
        if self.arena.len! >= self.limits.max_nodes
            failure: Result I64, ParseError = Result::Err (ParseError::at ParseErrorKind::TypeNodeLimit, start, end)
            return failure
        index = self.arena.len!
        self.arena.push (TypeNode
            kind: kind
            range: ByteRange
                start: start
                end: end
            children: children
            context: context)
        Result::Ok index

    ^@name: Result I64, ParseError
    ^@name = ->
        if !(self.is_name self.lexeme_index)
            failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedTypeName)
            return failure
        index = self.take! ?
        token = &self.lexemes[index].token
        retained = &token.context
        context = match *retained
            Option::Some value => Option::Some (value.clone!)
            Option::None => Option::None
        start = token.range.start
        self.add TypeKind::Name, start, Vec::new!, context

    ^@close: &Str -> U64 -> Result (), ParseError
    ^@close = text, opening ->
        if !(self.at text)
            mut error = self.failure ParseErrorKind::ExpectedTypeClose
            error.related = Option::Some (ByteRange
                start: opening
                end: opening + (1 as U64))
            failure: Result (), ParseError = Result::Err error
            return failure
        self.take! ?
        Result::Ok ()

    ^@read_type: I64 -> Result I64, ParseError
    ^@read_type = depth ->
        left = self.application depth ?
        if !(self.at "->")
            success: Result I64, ParseError = Result::Ok left
            return success
        mut children: Vec I64 = Vec::new!
        children.push left
        // Arrow chains are flat; a grouped return/argument remains one atom.
        // Iteration avoids recursive RHS walks and intermediate function nodes.
        while self.at "->"
            self.take! ?
            right = self.application depth ?
            children.push right
        start = self.arena[left].range.start
        self.add TypeKind::Function, start, children, Option::None

    ^@application: I64 -> Result I64, ParseError
    ^@application = depth ->
        head = self.atom depth ?
        mut children: Vec I64 = Vec::new!
        children.push head
        while self.starts_atom self.lexeme_index
            argument = self.atom (depth + 1) ?
            children.push argument
            if self.at ","
                if (self.starts_atom (self.lexeme_index + 1)) && !(self.where_subject (self.lexeme_index + 1))
                    self.take! ?
                else
                    break
        if children.len! == 1
            success: Result I64, ParseError = Result::Ok head
            return success
        start = self.arena[head].range.start
        self.add TypeKind::Application, start, children, Option::None

    ^@atom: I64 -> Result I64, ParseError
    ^@atom = depth ->
        if self.lexeme_index >= self.lexemes.len!
            failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedType)
            return failure
        if depth >= self.limits.max_depth
            failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::TypeDepthLimit)
            return failure
        start = self.lexemes[self.lexeme_index].token.range.start
        if self.is_name self.lexeme_index
            base = self.name! ?
            if self.at "::"
                self.take! ?
                member = self.name! ?
                mut children: Vec I64 = Vec::new!
                children.push base
                children.push member
                return self.add TypeKind::Associated, start, children, Option::None
            success: Result I64, ParseError = Result::Ok base
            return success
        if self.at "_"
            self.take! ?
            return self.add TypeKind::Hole, start, Vec::new!, Option::None
        if self.at "("
            self.take! ?
            if self.at ")"
                self.take! ?
                return self.add TypeKind::Unit, start, Vec::new!, Option::None
            mut children: Vec I64 = Vec::new!
            child = self.read_type (depth + 1) ?
            children.push child
            tuple = false
            while self.at ","
                tuple = true
                self.take! ?
                if self.at ")"
                    break
                child = self.read_type (depth + 1) ?
                children.push child
            self.close ")", start ?
            kind = if tuple then TypeKind::Tuple else TypeKind::Grouped
            return self.add kind, start, children, Option::None
        if self.at "&"
            self.take! ?
            kind = TypeKind::SharedReference
            if (self.at "mut") || (self.at "^")
                self.take! ?
                kind = TypeKind::MutableReference
            child = self.application (depth + 1) ?
            mut children: Vec I64 = Vec::new!
            children.push child
            return self.add kind, start, children, Option::None
        item = &self.lexemes[self.lexeme_index]
        pointer = item.token.tag! == "stuck-operator" && item.text == "*"
        if pointer
            self.take! ?
            child = self.application (depth + 1) ?
            mut children: Vec I64 = Vec::new!
            children.push child
            return self.add TypeKind::Pointer, start, children, Option::None
        if self.at "["
            self.take! ?
            child = self.read_type (depth + 1) ?
            mut children: Vec I64 = Vec::new!
            children.push child
            kind = TypeKind::Slice
            if self.at ";"
                self.take! ?
                if self.lexeme_index >= self.lexemes.len! || self.lexemes[self.lexeme_index].token.tag! != "number"
                    failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedArrayLength)
                    return failure
                index = self.take! ?
                value = self.array_length index ?
                length_start = self.lexemes[index].token.range.start
                length_node = self.add (TypeKind::ArrayLength value), length_start, Vec::new!, Option::None ?
                children.push length_node
                kind = TypeKind::Array
            self.close "]", start ?
            return self.add kind, start, children, Option::None
        Result::Err (self.failure ParseErrorKind::UnsupportedType)

    @array_length: I64 -> Result U64, ParseError
    @array_length = index ->
        mut chars = self.lexemes[index].text.char_indices!
        value: U64 = 0 as U64
        loop
            match chars.next!
                Option::None => break
                Option::Some item =>
                    digit = ((item.1 as U32) - ('0' as U32)) as U64
                    if value > (1844674407370955161 as U64) || (value == (1844674407370955161 as U64) && digit > (5 as U64))
                        token = &self.lexemes[index].token
                        failure: Result U64, ParseError = Result::Err (ParseError::at ParseErrorKind::InvalidArrayLength, (token.range.start), (token.range.end))
                        return failure
                    value = value * (10 as U64) + digit
        Result::Ok value
