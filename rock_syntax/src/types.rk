// Library-owned type/binder/constraint trees; no compiler AST or semantics.
> rock_macro::*
> rock_macro::construction::MacroBuilder
> rock_syntax::*
> rock_syntax::parser::Parser
> std::collections::vec::Vec
> std::control::option::Option
> std::control::result::Result
> std::clone::Clone
> std::convert::From
> std::string::owned::String
> std::num::arithmetic::Add
> std::num::arithmetic::Sub
> std::cmp::eq::PartialEq
> std::cmp::ord::PartialOrd
> std::ops::index::Index
> std::ops::not::Not

< struct TypeLimits
    < max_depth: I64
    < max_nodes: I64

impl TypeLimits
    standard: TypeLimits
    standard = -> TypeLimits
        max_depth: 128
        max_nodes: 65536

< enum TypeKind
    Name
    Associated
    Application
    SharedReference
    MutableReference
    Pointer
    Unit
    Grouped
    Tuple
    Slice
    Array
    ArrayLength U64
    Hole
    Function

< struct TypeNode
    < kind: TypeKind
    < range: ByteRange
    < children: Vec I64
    < context: Option SyntaxContext

// Flat postorder storage keeps destruction nonrecursive. Child indices are
// earlier than their parent; grouping remains explicit for lossless consumers.
< struct TypeSyntax
    stream: TokenStream
    arena: Vec TypeNode
    root_index: I64

impl TypeSyntax
    parse: TokenStream -> Result TypeSyntax, ParseError
    parse = input -> TypeSyntax::parse_with_limits input, Limits::standard!, TypeLimits::standard!

    parse_with_limits: TokenStream -> Limits -> TypeLimits -> Result TypeSyntax, ParseError
    parse_with_limits = input, lexical_limits, limits ->
        mut parser = Parser::new input, lexical_limits, limits ?
        root = parser.read_type 0 ?
        if parser.lexeme_index < parser.lexemes.len!
            failure: Result TypeSyntax, ParseError = Result::Err (parser.failure ParseErrorKind::TrailingTypeTokens)
            return failure
        Result::Ok (TypeSyntax
            stream: parser.lexer_cursor.input!.clone!
            arena: parser.arena
            root_index: root)

    @nodes: &Vec TypeNode
    @nodes = -> &self.arena

    @root: I64
    @root = -> self.root_index

    @original: &TokenStream
    @original = -> &self.stream

    // C.04 emission supports unchanged nodes only: preserve, never print ASTs.
    @emit: TokenStream
    @emit = -> self.stream.clone!

    @node_tokens: I64 -> Result TokenStream, ParseError
    @node_tokens = index ->
        if index < 0 || index >= self.arena.len!
            failure: Result TokenStream, ParseError = Result::Err (ParseError::at (ParseErrorKind::InvalidTypeNode index), 0, 0)
            return failure
        match self.stream.slice (self.arena[index].range.clone!)
            Result::Ok tokens => Result::Ok tokens
            Result::Err error => Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), 0, 0)

impl TypeKind
    @tag: &Str
    @tag = ->
        match *self
            TypeKind::Name => "name"
            TypeKind::Associated => "path"
            TypeKind::Application => "apply"
            TypeKind::SharedReference => "ref"
            TypeKind::MutableReference => "mut-ref"
            TypeKind::Pointer => "pointer"
            TypeKind::Unit => "unit"
            TypeKind::Grouped => "group"
            TypeKind::Tuple => "tuple"
            TypeKind::Slice => "slice"
            TypeKind::Array => "array"
            TypeKind::ArrayLength value => "length"
            TypeKind::Hole => "hole"
            TypeKind::Function => "function"

< struct GenericParam
    < name: I64
    // Holes use an Application node; explicit kinds use their type root.
    < kind: Option I64
    < explicit_kind: Bool
    < default_type: Option I64
    < range: ByteRange
    < impl_range: ByteRange

< struct GenericSyntax
    stream: TokenStream
    arena: Vec TypeNode
    parameters: Vec GenericParam
    separators: Vec ByteRange

< struct Constraint
    < subject: I64
    < trait_bound: Option I64
    < range: ByteRange

< struct BoundsSyntax
    stream: TokenStream
    arena: Vec TypeNode
    clauses: Vec Constraint

// Use original SDK operations for every captured piece, including separators.
syntax_slice: &TokenStream -> ByteRange -> Result TokenStream, ParseError
syntax_slice = stream, range ->
    start = range.start
    end = range.end
    match stream.slice range
        Result::Ok tokens => Result::Ok tokens
        Result::Err error => Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), start, end)

syntax_join: &TokenStream -> &TokenStream -> Result TokenStream, ParseError
syntax_join = left, right ->
    match left.join right, JoinBoundary::Separate
        Result::Ok tokens => Result::Ok tokens
        Result::Err error => Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), 0, 0)

impl GenericSyntax
    parse: TokenStream -> Result GenericSyntax, ParseError
    parse = input -> GenericSyntax::parse_with_limits input, Limits::standard!, TypeLimits::standard!

    parse_with_limits: TokenStream -> Limits -> TypeLimits -> Result GenericSyntax, ParseError
    parse_with_limits = input, lexical_limits, limits ->
        mut parser = Parser::new input, lexical_limits, limits ?
        mut parameters: Vec GenericParam = Vec::new!
        mut separators: Vec ByteRange = Vec::new!
        while parser.lexeme_index < parser.lexemes.len!
            parameter = parser.binder! ?
            parameters.push parameter
            if !(parser.at ",")
                break
            index = parser.take! ?
            separators.push (parser.lexemes[index].token.range.clone!)
        if parser.lexeme_index < parser.lexemes.len!
            failure: Result GenericSyntax, ParseError = Result::Err (parser.failure ParseErrorKind::TrailingGenericTokens)
            return failure
        Result::Ok (GenericSyntax
            stream: parser.lexer_cursor.input!.clone!
            arena: parser.arena
            parameters: parameters
            separators: separators)

    @params: &Vec GenericParam
    @params = -> &self.parameters

    @nodes: &Vec TypeNode
    @nodes = -> &self.arena

    @original: &TokenStream
    @original = -> &self.stream

    @emit: TokenStream
    @emit = -> self.stream.clone!

    // Impl generics are implicit in Rock: these are unbounded WHERE subjects,
    // not a declaration binder list. A bare constructor name would declare Type.
    @impl_binders: &mut MacroBuilder -> Result TokenStream, ParseError
    @impl_binders = builder -> self.application_parameters builder

    @type_arguments: &mut MacroBuilder -> Result TokenStream, ParseError
    @type_arguments = builder -> self.application_parameters builder

    @application_parameters: &mut MacroBuilder -> Result TokenStream, ParseError
    @application_parameters = builder ->
        output = syntax_slice &self.stream, (ByteRange
            start: 0
            end: 0) ?
        i = 0
        while i < self.parameters.len!
            parameter = &self.parameters[i]
            if i > 0
                comma = syntax_slice &self.stream, (self.separators[i - 1].clone!) ?
                output = syntax_join &output, &comma ?
            tokens = syntax_slice &self.stream, (parameter.impl_range.clone!) ?
            retained_kind = &parameter.kind
            match *retained_kind
                Option::Some root =>
                    if parameter.explicit_kind
                        index = root
                        while self.arena[index].kind.tag! == "group"
                            index = self.arena[index].children[0]
                        if self.arena[index].kind.tag! != "name"
                            failure: Result TokenStream, ParseError = Result::Err (ParseError::at ParseErrorKind::UnsupportedBinderEmission, (parameter.range.start), (parameter.range.end))
                            return failure
                    else
                        // Without grouping, a constructor's comma arguments can
                        // absorb the next unbounded WHERE subject.
                        tokens = match builder.group Delimiter::Paren, &tokens
                            Result::Ok grouped => grouped
                            Result::Err error =>
                                failure: Result TokenStream, ParseError = Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), (parameter.range.start), (parameter.range.end))
                                return failure
                Option::None => ()
            output = syntax_join &output, &tokens ?
            i = i + 1
        Result::Ok output

impl BoundsSyntax
    parse: TokenStream -> Result BoundsSyntax, ParseError
    parse = input -> BoundsSyntax::parse_with_limits input, Limits::standard!, TypeLimits::standard!

    parse_with_limits: TokenStream -> Limits -> TypeLimits -> Result BoundsSyntax, ParseError
    parse_with_limits = input, lexical_limits, limits ->
        mut parser = Parser::new input, lexical_limits, limits ?
        if !(parser.at "where")
            failure: Result BoundsSyntax, ParseError = Result::Err (parser.failure ParseErrorKind::ExpectedWhere)
            return failure
        parser.take! ?
        mut clauses: Vec Constraint = Vec::new!
        loop
            subject = parser.read_type 0 ?
            start = parser.arena[subject].range.start
            mut trait_bound: Option I64 = Option::None
            if parser.at ":"
                parser.take! ?
                bound = parser.read_type 0 ?
                trait_bound = Option::Some bound
            clauses.push (Constraint
                subject: subject
                trait_bound: trait_bound
                range: ByteRange
                    start: start
                    end: parser.last_end)
            if !(parser.at ",")
                break
            parser.take! ?
        if parser.lexeme_index < parser.lexemes.len!
            failure: Result BoundsSyntax, ParseError = Result::Err (parser.failure ParseErrorKind::TrailingGenericTokens)
            return failure
        Result::Ok (BoundsSyntax
            stream: parser.lexer_cursor.input!.clone!
            arena: parser.arena
            clauses: clauses)

    @constraints: &Vec Constraint
    @constraints = -> &self.clauses

    @nodes: &Vec TypeNode
    @nodes = -> &self.arena

    @original: &TokenStream
    @original = -> &self.stream

    @emit: TokenStream
    @emit = -> self.stream.clone!
