// Library-owned type/binder/constraint trees; no compiler AST or semantics.
> rock_macro::*
> rock_macro::construction::MacroBuilder
> rock_syntax::*
> rock_syntax::cursor::Cursor
> std::collections::vec::Vec
> std::control::option::Option
> std::control::result::Result
> std::clone::Clone
> std::convert::From
> std::string::owned::String
> std::num::arithmetic::Add
> std::num::arithmetic::Sub
> std::num::arithmetic::Mul
> std::cmp::eq::PartialEq
> std::cmp::ord::PartialOrd
> std::ops::index::Index
> std::ops::not::Not

< struct TypeLimits
    < max_depth: I64
    < max_nodes: I64

impl TypeLimits
    standard: TypeLimits
    standard = -> TypeLimits
        max_depth: 128
        max_nodes: 65536

< enum TypeKind
    Name
    Associated
    Application
    SharedReference
    MutableReference
    Pointer
    Unit
    Grouped
    Tuple
    Slice
    Array
    ArrayLength U64
    Hole
    Function

< struct TypeNode
    < kind: TypeKind
    < range: ByteRange
    < children: Vec I64
    < context: Option SyntaxContext

// Flat postorder storage keeps destruction nonrecursive. Child indices are
// earlier than their parent; grouping remains explicit for lossless consumers.
< struct TypeSyntax
    stream: TokenStream
    arena: Vec TypeNode
    root_index: I64

struct Lexeme
    < token: Token
    < text: String

struct Parser
    < lexer_cursor: Cursor
    < lexemes: Vec Lexeme
    < arena: Vec TypeNode
    < lexeme_index: I64
    < last_end: U64
    < limits: TypeLimits

impl TypeSyntax
    parse: TokenStream -> Result TypeSyntax, ParseError
    parse = input -> TypeSyntax::parse_with_limits input, Limits::standard!, TypeLimits::standard!

    parse_with_limits: TokenStream -> Limits -> TypeLimits -> Result TypeSyntax, ParseError
    parse_with_limits = input, lexical_limits, limits ->
        mut parser = Parser::new input, lexical_limits, limits ?
        root = parser.read_type 0 ?
        if parser.lexeme_index < parser.lexemes.len!
            failure: Result TypeSyntax, ParseError = Result::Err (parser.failure ParseErrorKind::TrailingTypeTokens)
            return failure
        Result::Ok (TypeSyntax
            stream: parser.lexer_cursor.input!.clone!
            arena: parser.arena
            root_index: root)

    @nodes: &Vec TypeNode
    @nodes = -> &self.arena

    @root: I64
    @root = -> self.root_index

    @original: &TokenStream
    @original = -> &self.stream

    // C.04 emission supports unchanged nodes only: preserve, never print ASTs.
    @emit: TokenStream
    @emit = -> self.stream.clone!

    @node_tokens: I64 -> Result TokenStream, ParseError
    @node_tokens = index ->
        if index < 0 || index >= self.arena.len!
            failure: Result TokenStream, ParseError = Result::Err (ParseError::at (ParseErrorKind::InvalidTypeNode index), 0, 0)
            return failure
        match self.stream.slice (self.arena[index].range.clone!)
            Result::Ok tokens => Result::Ok tokens
            Result::Err error => Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), 0, 0)

impl TypeKind
    @tag: &Str
    @tag = ->
        match *self
            TypeKind::Name => "name"
            TypeKind::Associated => "path"
            TypeKind::Application => "apply"
            TypeKind::SharedReference => "ref"
            TypeKind::MutableReference => "mut-ref"
            TypeKind::Pointer => "pointer"
            TypeKind::Unit => "unit"
            TypeKind::Grouped => "group"
            TypeKind::Tuple => "tuple"
            TypeKind::Slice => "slice"
            TypeKind::Array => "array"
            TypeKind::ArrayLength value => "length"
            TypeKind::Hole => "hole"
            TypeKind::Function => "function"

impl Parser
    new: TokenStream -> Limits -> TypeLimits -> Result Parser, ParseError
    new = input, lexical_limits, limits ->
        if limits.max_depth < 0 || limits.max_depth > 128 || limits.max_nodes < 0 || limits.max_nodes > 65536
            failure: Result Parser, ParseError = Result::Err (ParseError::at ParseErrorKind::InvalidLimits, 0, 0)
            return failure
        mut cursor = Cursor::with_limits input, lexical_limits ?
        mut lexemes: Vec Lexeme = Vec::new!
        loop
            match cursor.next_token! ?
                Option::None => break
                Option::Some token =>
                    text = cursor.spelling &token ?
                    lexemes.push (Lexeme
                        token: token
                        text: text)
        Result::Ok (Parser
            lexer_cursor: cursor
            lexemes: lexemes
            arena: Vec::new!
            lexeme_index: 0
            last_end: 0
            limits: limits)

    @failure: ParseErrorKind -> ParseError
    @failure = kind ->
        if self.lexeme_index < self.lexemes.len!
            token = &self.lexemes[self.lexeme_index].token
            return ParseError::at kind, (token.range.start), (token.range.end)
        offset = self.lexer_cursor.byte_offset!
        ParseError::at kind, offset, offset

    @at: &Str -> Bool
    @at = text ->
        if self.lexeme_index >= self.lexemes.len!
            return false
        item = &self.lexemes[self.lexeme_index]
        tag = item.token.tag!
        (tag == "symbol" || tag == "operator" || tag == "stuck-operator" || tag == "keyword") && item.text == text

    @is_name: I64 -> Bool
    @is_name = index -> index < self.lexemes.len! && self.lexemes[index].token.tag! == "type"

    @starts_atom: I64 -> Bool
    @starts_atom = index ->
        if index >= self.lexemes.len!
            return false
        item = &self.lexemes[index]
        tag = item.token.tag!
        tag == "type" || (tag == "symbol" && (item.text == "_" || item.text == "(" || item.text == "[" || item.text == "&")) || (tag == "stuck-operator" && item.text == "*")

    @where_subject: I64 -> Bool
    @where_subject = index ->
        if !(self.is_name index) || index + 1 >= self.lexemes.len!
            return false
        if self.lexemes[index + 1].text == ":"
            return true
        index + 2 < self.lexemes.len! && self.lexemes[index + 1].text == "_" && self.lexemes[index + 2].text == ":"

    ^@take: Result I64, ParseError
    ^@take = ->
        if self.lexeme_index >= self.lexemes.len!
            failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedType)
            return failure
        index = self.lexeme_index
        self.lexeme_index = self.lexeme_index + 1
        self.last_end = self.lexemes[index].token.range.end
        Result::Ok index

    ^@add: TypeKind -> U64 -> Vec I64 -> Option SyntaxContext -> Result I64, ParseError
    ^@add = kind, start, children, context ->
        end = self.last_end
        if self.arena.len! >= self.limits.max_nodes
            failure: Result I64, ParseError = Result::Err (ParseError::at ParseErrorKind::TypeNodeLimit, start, end)
            return failure
        index = self.arena.len!
        self.arena.push (TypeNode
            kind: kind
            range: ByteRange
                start: start
                end: end
            children: children
            context: context)
        Result::Ok index

    ^@name: Result I64, ParseError
    ^@name = ->
        if !(self.is_name self.lexeme_index)
            failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedTypeName)
            return failure
        index = self.take! ?
        token = &self.lexemes[index].token
        retained = &token.context
        context = match *retained
            Option::Some value => Option::Some (value.clone!)
            Option::None => Option::None
        start = token.range.start
        self.add TypeKind::Name, start, Vec::new!, context

    ^@close: &Str -> U64 -> Result (), ParseError
    ^@close = text, opening ->
        if !(self.at text)
            mut error = self.failure ParseErrorKind::ExpectedTypeClose
            error.related = Option::Some (ByteRange
                start: opening
                end: opening + (1 as U64))
            failure: Result (), ParseError = Result::Err error
            return failure
        self.take! ?
        Result::Ok ()

    ^@read_type: I64 -> Result I64, ParseError
    ^@read_type = depth ->
        left = self.application depth ?
        if !(self.at "->")
            success: Result I64, ParseError = Result::Ok left
            return success
        mut children: Vec I64 = Vec::new!
        children.push left
        // Arrow chains are flat; a grouped return/argument remains one atom.
        // Iteration avoids recursive RHS walks and intermediate function nodes.
        while self.at "->"
            self.take! ?
            right = self.application depth ?
            children.push right
        start = self.arena[left].range.start
        self.add TypeKind::Function, start, children, Option::None

    ^@application: I64 -> Result I64, ParseError
    ^@application = depth ->
        head = self.atom depth ?
        mut children: Vec I64 = Vec::new!
        children.push head
        while self.starts_atom self.lexeme_index
            argument = self.atom (depth + 1) ?
            children.push argument
            if self.at ","
                if (self.starts_atom (self.lexeme_index + 1)) && !(self.where_subject (self.lexeme_index + 1))
                    self.take! ?
                else
                    break
        if children.len! == 1
            success: Result I64, ParseError = Result::Ok head
            return success
        start = self.arena[head].range.start
        self.add TypeKind::Application, start, children, Option::None

    ^@atom: I64 -> Result I64, ParseError
    ^@atom = depth ->
        if self.lexeme_index >= self.lexemes.len!
            failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedType)
            return failure
        if depth >= self.limits.max_depth
            failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::TypeDepthLimit)
            return failure
        start = self.lexemes[self.lexeme_index].token.range.start
        if self.is_name self.lexeme_index
            base = self.name! ?
            if self.at "::"
                self.take! ?
                member = self.name! ?
                mut children: Vec I64 = Vec::new!
                children.push base
                children.push member
                return self.add TypeKind::Associated, start, children, Option::None
            success: Result I64, ParseError = Result::Ok base
            return success
        if self.at "_"
            self.take! ?
            return self.add TypeKind::Hole, start, Vec::new!, Option::None
        if self.at "("
            self.take! ?
            if self.at ")"
                self.take! ?
                return self.add TypeKind::Unit, start, Vec::new!, Option::None
            mut children: Vec I64 = Vec::new!
            child = self.read_type (depth + 1) ?
            children.push child
            tuple = false
            while self.at ","
                tuple = true
                self.take! ?
                if self.at ")"
                    break
                child = self.read_type (depth + 1) ?
                children.push child
            self.close ")", start ?
            kind = if tuple then TypeKind::Tuple else TypeKind::Grouped
            return self.add kind, start, children, Option::None
        if self.at "&"
            self.take! ?
            kind = TypeKind::SharedReference
            if (self.at "mut") || (self.at "^")
                self.take! ?
                kind = TypeKind::MutableReference
            child = self.application (depth + 1) ?
            mut children: Vec I64 = Vec::new!
            children.push child
            return self.add kind, start, children, Option::None
        item = &self.lexemes[self.lexeme_index]
        pointer = item.token.tag! == "stuck-operator" && item.text == "*"
        if pointer
            self.take! ?
            child = self.application (depth + 1) ?
            mut children: Vec I64 = Vec::new!
            children.push child
            return self.add TypeKind::Pointer, start, children, Option::None
        if self.at "["
            self.take! ?
            child = self.read_type (depth + 1) ?
            mut children: Vec I64 = Vec::new!
            children.push child
            kind = TypeKind::Slice
            if self.at ";"
                self.take! ?
                if self.lexeme_index >= self.lexemes.len! || self.lexemes[self.lexeme_index].token.tag! != "number"
                    failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedArrayLength)
                    return failure
                index = self.take! ?
                value = self.array_length index ?
                length_start = self.lexemes[index].token.range.start
                length_node = self.add (TypeKind::ArrayLength value), length_start, Vec::new!, Option::None ?
                children.push length_node
                kind = TypeKind::Array
            self.close "]", start ?
            return self.add kind, start, children, Option::None
        Result::Err (self.failure ParseErrorKind::UnsupportedType)

    @array_length: I64 -> Result U64, ParseError
    @array_length = index ->
        mut chars = self.lexemes[index].text.char_indices!
        value: U64 = 0 as U64
        loop
            match chars.next!
                Option::None => break
                Option::Some item =>
                    digit = ((item.1 as U32) - ('0' as U32)) as U64
                    if value > (1844674407370955161 as U64) || (value == (1844674407370955161 as U64) && digit > (5 as U64))
                        token = &self.lexemes[index].token
                        failure: Result U64, ParseError = Result::Err (ParseError::at ParseErrorKind::InvalidArrayLength, (token.range.start), (token.range.end))
                        return failure
                    value = value * (10 as U64) + digit
        Result::Ok value

< struct GenericParam
    < name: I64
    // Holes use an Application node; explicit kinds use their type root.
    < kind: Option I64
    < explicit_kind: Bool
    < default_type: Option I64
    < range: ByteRange
    < impl_range: ByteRange

< struct GenericSyntax
    stream: TokenStream
    arena: Vec TypeNode
    parameters: Vec GenericParam
    separators: Vec ByteRange

< struct Constraint
    < subject: I64
    < trait_bound: Option I64
    < range: ByteRange

< struct BoundsSyntax
    stream: TokenStream
    arena: Vec TypeNode
    clauses: Vec Constraint

// Use original SDK operations for every captured piece, including separators.
syntax_slice: &TokenStream -> ByteRange -> Result TokenStream, ParseError
syntax_slice = stream, range ->
    start = range.start
    end = range.end
    match stream.slice range
        Result::Ok tokens => Result::Ok tokens
        Result::Err error => Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), start, end)

syntax_join: &TokenStream -> &TokenStream -> Result TokenStream, ParseError
syntax_join = left, right ->
    match left.join right, JoinBoundary::Separate
        Result::Ok tokens => Result::Ok tokens
        Result::Err error => Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), 0, 0)

impl GenericSyntax
    parse: TokenStream -> Result GenericSyntax, ParseError
    parse = input -> GenericSyntax::parse_with_limits input, Limits::standard!, TypeLimits::standard!

    parse_with_limits: TokenStream -> Limits -> TypeLimits -> Result GenericSyntax, ParseError
    parse_with_limits = input, lexical_limits, limits ->
        mut parser = Parser::new input, lexical_limits, limits ?
        mut parameters: Vec GenericParam = Vec::new!
        mut separators: Vec ByteRange = Vec::new!
        while parser.lexeme_index < parser.lexemes.len!
            parameter = parser.binder! ?
            parameters.push parameter
            if !(parser.at ",")
                break
            index = parser.take! ?
            separators.push (parser.lexemes[index].token.range.clone!)
        if parser.lexeme_index < parser.lexemes.len!
            failure: Result GenericSyntax, ParseError = Result::Err (parser.failure ParseErrorKind::TrailingGenericTokens)
            return failure
        Result::Ok (GenericSyntax
            stream: parser.lexer_cursor.input!.clone!
            arena: parser.arena
            parameters: parameters
            separators: separators)

    @params: &Vec GenericParam
    @params = -> &self.parameters

    @nodes: &Vec TypeNode
    @nodes = -> &self.arena

    @original: &TokenStream
    @original = -> &self.stream

    @emit: TokenStream
    @emit = -> self.stream.clone!

    // Impl generics are implicit in Rock: these are unbounded WHERE subjects,
    // not a declaration binder list. A bare constructor name would declare Type.
    @impl_binders: &mut MacroBuilder -> Result TokenStream, ParseError
    @impl_binders = builder -> self.application_parameters builder

    @type_arguments: &mut MacroBuilder -> Result TokenStream, ParseError
    @type_arguments = builder -> self.application_parameters builder

    @application_parameters: &mut MacroBuilder -> Result TokenStream, ParseError
    @application_parameters = builder ->
        output = syntax_slice &self.stream, (ByteRange
            start: 0
            end: 0) ?
        i = 0
        while i < self.parameters.len!
            parameter = &self.parameters[i]
            if i > 0
                comma = syntax_slice &self.stream, (self.separators[i - 1].clone!) ?
                output = syntax_join &output, &comma ?
            tokens = syntax_slice &self.stream, (parameter.impl_range.clone!) ?
            retained_kind = &parameter.kind
            match *retained_kind
                Option::Some root =>
                    if parameter.explicit_kind
                        index = root
                        while self.arena[index].kind.tag! == "group"
                            index = self.arena[index].children[0]
                        if self.arena[index].kind.tag! != "name"
                            failure: Result TokenStream, ParseError = Result::Err (ParseError::at ParseErrorKind::UnsupportedBinderEmission, (parameter.range.start), (parameter.range.end))
                            return failure
                    else
                        // Without grouping, a constructor's comma arguments can
                        // absorb the next unbounded WHERE subject.
                        tokens = match builder.group Delimiter::Paren, &tokens
                            Result::Ok grouped => grouped
                            Result::Err error =>
                                failure: Result TokenStream, ParseError = Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), (parameter.range.start), (parameter.range.end))
                                return failure
                Option::None => ()
            output = syntax_join &output, &tokens ?
            i = i + 1
        Result::Ok output

impl BoundsSyntax
    parse: TokenStream -> Result BoundsSyntax, ParseError
    parse = input -> BoundsSyntax::parse_with_limits input, Limits::standard!, TypeLimits::standard!

    parse_with_limits: TokenStream -> Limits -> TypeLimits -> Result BoundsSyntax, ParseError
    parse_with_limits = input, lexical_limits, limits ->
        mut parser = Parser::new input, lexical_limits, limits ?
        if !(parser.at "where")
            failure: Result BoundsSyntax, ParseError = Result::Err (parser.failure ParseErrorKind::ExpectedWhere)
            return failure
        parser.take! ?
        mut clauses: Vec Constraint = Vec::new!
        loop
            subject = parser.read_type 0 ?
            start = parser.arena[subject].range.start
            mut trait_bound: Option I64 = Option::None
            if parser.at ":"
                parser.take! ?
                bound = parser.read_type 0 ?
                trait_bound = Option::Some bound
            clauses.push (Constraint
                subject: subject
                trait_bound: trait_bound
                range: ByteRange
                    start: start
                    end: parser.last_end)
            if !(parser.at ",")
                break
            parser.take! ?
        if parser.lexeme_index < parser.lexemes.len!
            failure: Result BoundsSyntax, ParseError = Result::Err (parser.failure ParseErrorKind::TrailingGenericTokens)
            return failure
        Result::Ok (BoundsSyntax
            stream: parser.lexer_cursor.input!.clone!
            arena: parser.arena
            clauses: clauses)

    @constraints: &Vec Constraint
    @constraints = -> &self.clauses

    @nodes: &Vec TypeNode
    @nodes = -> &self.arena

    @original: &TokenStream
    @original = -> &self.stream

    @emit: TokenStream
    @emit = -> self.stream.clone!

impl Parser
    ^@binder: Result GenericParam, ParseError
    ^@binder = ->
        if self.lexeme_index >= self.lexemes.len!
            failure: Result GenericParam, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedBinder)
            return failure
        start = self.lexemes[self.lexeme_index].token.range.start
        defaulted = self.at "{"
        if defaulted
            self.take! ?
        grouped = self.at "("
        opening = self.last_end
        if grouped
            index = self.take! ?
            opening = self.lexemes[index].token.range.start
        if !(self.is_name self.lexeme_index)
            failure: Result GenericParam, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedBinder)
            return failure
        name = self.name! ?
        name_start = self.arena[name].range.start
        impl_end = self.last_end
        mut kind: Option I64 = Option::None
        explicit_kind = false
        if (self.at ":") && (grouped || defaulted)
            self.take! ?
            kind_start = self.lexeme_index
            first_node = self.arena.len!
            root = self.read_type 0 ?
            if !(self.valid_kind first_node)
                token = &self.lexemes[kind_start].token
                failure: Result GenericParam, ParseError = Result::Err (ParseError::at ParseErrorKind::InvalidBinderKind, (token.range.start), (token.range.end))
                return failure
            kind = Option::Some root
            explicit_kind = true
        else
            if (self.at "_") && (grouped || defaulted)
                mut children: Vec I64 = Vec::new!
                children.push name
                loop
                    if !(self.at "_")
                        failure: Result GenericParam, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedBinderKind)
                        return failure
                    hole = self.atom 0 ?
                    children.push hole
                    if !(self.at ",")
                        break
                    self.take! ?
                root = self.add TypeKind::Application, name_start, children, Option::None ?
                kind = Option::Some root
                impl_end = self.last_end
            else
                if grouped
                    failure: Result GenericParam, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedBinderKind)
                    return failure
        if grouped
            self.close ")", opening ?
        mut default_type: Option I64 = Option::None
        if defaulted
            if !(self.at "=")
                failure: Result GenericParam, ParseError = Result::Err (self.failure ParseErrorKind::ExpectedDefault)
                return failure
            self.take! ?
            root = self.read_type 0 ?
            default_type = Option::Some root
            self.close "}", start ?
        Result::Ok (GenericParam
            name: name
            kind: kind
            explicit_kind: explicit_kind
            default_type: default_type
            range: ByteRange
                start: start
                end: self.last_end
            impl_range: ByteRange
                start: name_start
                end: impl_end)

    // Postorder grammar validation, not semantic kind/name resolution.
    @valid_kind: I64 -> Bool
    @valid_kind = first ->
        i = first
        while i < self.arena.len!
            node = &self.arena[i]
            kind = &node.kind
            match *kind
                TypeKind::Name =>
                    token = Token
                        kind: TokenKind::Type
                        range: node.range.clone!
                        context: Option::None
                    match self.lexer_cursor.spelling &token
                        Result::Ok text => if text != "Type" then return false
                        Result::Err error => return false
                TypeKind::Function => ()
                TypeKind::Grouped => ()
                _ => return false
            i = i + 1
        true
