// Output-only construction: copied syntax always remains an SDK stream.
> rock_macro::*
> rock_syntax::types::TypeKind
> rock_syntax::cursor::Cursor
> std::collections::vec::Vec
> std::control::option::Option
> std::control::result::Result
> std::clone::Clone
> std::convert::From
> std::string::owned::String
> std::num::arithmetic::Add
> std::num::arithmetic::Sub
> std::num::arithmetic::Mul
> std::num::arithmetic::Div
> std::num::arithmetic::Rem
> std::cmp::eq::PartialEq
> std::cmp::ord::PartialOrd
> std::ops::index::Index
> std::ops::not::Not

// Append by ownership, with no repeated deep copies of the accumulated prefix.
// Limits match the SDK authoring helpers, including retained snapshot storage.
< struct OutputBuffer
    parts: Vec OutputPart
    bytes: I64
    retained: I64

impl OutputBuffer
    new: OutputBuffer
    new = -> OutputBuffer
        parts: Vec::new!
        bytes: 0
        retained: 0

    ^@append: &MacroContext -> MacroOutput -> Result (), Diagnostic
    ^@append = context, mut output ->
        bytes = self.bytes
        retained = self.retained
        if output.parts.len! > 16384 - self.parts.len!
            failure: Result (), Diagnostic = Result::Err (context.error (String::from "output exceeds the part limit"))
            return failure
        i = 0
        while i < output.parts.len!
            part = &output.parts[i]
            length = context.part_length part ?
            cost = context.part_copy_cost part
            if length > 1048576 - bytes || cost > 16777216 - retained
                failure: Result (), Diagnostic = Result::Err (context.error (String::from "output exceeds the byte or retained storage limit"))
                return failure
            bytes = bytes + length
            retained = retained + cost
            i = i + 1
        mut reversed: Vec OutputPart = Vec::new!
        while output.parts.len! > 0
            last = output.parts.len! - 1
            match output.parts.swap_remove last
                Option::Some part => reversed.push part
                Option::None => ()
        while reversed.len! > 0
            last = reversed.len! - 1
            match reversed.swap_remove last
                Option::Some part => self.parts.push part
                Option::None => ()
        self.bytes = bytes
        self.retained = retained
        Result::Ok ()

    ~@output: MacroOutput
    ~@output = -> MacroOutput
        parts: self.parts

// Translate only physical line margins, never quote/comment/capture interiors.
// The result contains original SDK slices and can be parsed locally again.
< struct LayoutEmitter

impl LayoutEmitter
    unindent: &MacroContext -> TokenStream -> U64 -> Result TokenStream, Diagnostic
    unindent = context, input, margin ->
        length = match input.len_bytes!
            Result::Ok length => length
            Result::Err _ =>
                failure: Result TokenStream, Diagnostic = Result::Err (context.error (String::from "invalid layout input"))
                return failure
        if margin > (254 as U64) || length > (1048576 as U64)
            failure: Result TokenStream, Diagnostic = Result::Err (context.error (String::from "layout input exceeds the margin or byte limit"))
            return failure
        if margin == (0 as U64)
            success: Result TokenStream, Diagnostic = Result::Ok input
            return success
        mut cursor = match Cursor::new input.clone!
            Result::Ok cursor => cursor
            Result::Err error =>
                failure: Result TokenStream, Diagnostic = Result::Err (error.diagnostic!)
                return failure
        part = OutputPart::Stream input
        cost = context.part_copy_cost &part
        mut cuts: Vec ByteRange = Vec::new!
        first = true
        loop
            token = match cursor.consume!
                Result::Ok token => token
                Result::Err error =>
                    failure: Result TokenStream, Diagnostic = Result::Err (error.diagnostic!)
                    return failure
            match token
                Option::None => break
                Option::Some token =>
                    if first && token.tag! == "whitespace" && token.range.end - token.range.start >= margin
                        prefix = match cursor.slice_range (ByteRange
                            start: token.range.start
                            end: token.range.start + margin)
                            Result::Ok prefix => prefix
                            Result::Err error =>
                                failure: Result TokenStream, Diagnostic = Result::Err (error.diagnostic!)
                                return failure
                        spelling = match prefix.spelling!
                            Result::Ok spelling => spelling
                            Result::Err _ =>
                                failure: Result TokenStream, Diagnostic = Result::Err (context.error (String::from "invalid layout prefix"))
                                return failure
                        chars = spelling.as_bytes!
                        i = 0
                        while i < chars.len!
                            if chars[i] != (' ' as U8)
                                failure: Result TokenStream, Diagnostic = Result::Err (context.error (String::from "layout prefixes must contain spaces"))
                                return failure
                            i = i + 1
                        // Joining growing prefixes also copies their split
                        // segment records; charge quadratic work, not just text.
                        copies = cuts.len! + 3
                        if cuts.len! >= 16384 || cost > 16777216 / (2 * copies * copies)
                            failure: Result TokenStream, Diagnostic = Result::Err (context.error (String::from "layout exceeds the retained copy limit"))
                            return failure
                        cuts.push (ByteRange
                            start: token.range.start
                            end: token.range.start + margin)
                    first = token.tag! == "line-ending"
        if cuts.len! == 0
            success: Result TokenStream, Diagnostic = Result::Ok (cursor.input!.clone!)
            return success
        output = match cursor.slice_range (ByteRange
            start: 0
            end: 0)
            Result::Ok output => output
            Result::Err error =>
                failure: Result TokenStream, Diagnostic = Result::Err (error.diagnostic!)
                return failure
        offset: U64 = 0 as U64
        i = 0
        while i <= cuts.len!
            stop = if i < cuts.len! then cuts[i].start else length
            piece = match cursor.slice_range (ByteRange
                start: offset
                end: stop)
                Result::Ok piece => piece
                Result::Err error =>
                    failure: Result TokenStream, Diagnostic = Result::Err (error.diagnostic!)
                    return failure
            output = match output.join &piece, JoinBoundary::Separate
                Result::Ok joined => joined
                Result::Err _ =>
                    failure: Result TokenStream, Diagnostic = Result::Err (context.error (String::from "invalid layout join"))
                    return failure
            if i < cuts.len!
                offset = cuts[i].end
            i = i + 1
        Result::Ok output

// Ordered edits use original logical byte offsets, never offsets in prior output.
// Failed replacements leave the script unchanged; overlapping edits diagnose.
< struct TokenEdits
    input_stream: TokenStream
    next_offset: U64
    total_bytes: U64
    accumulated: OutputBuffer

impl TokenEdits
    new: TokenStream -> Result TokenEdits, Diagnostic
    new = original ->
        length = match original.len_bytes!
            Result::Ok length => length
            Result::Err _ =>
                failure: Result TokenEdits, Diagnostic = Result::Err (Diagnostic::new DiagnosticSeverity::Error, (String::from "invalid edit input"), DiagnosticLocation::Invocation)
                return failure
        if length > (1048576 as U64)
            failure: Result TokenEdits, Diagnostic = Result::Err (Diagnostic::new DiagnosticSeverity::Error, (String::from "edit input exceeds the byte limit"), DiagnosticLocation::Invocation)
            return failure
        Result::Ok (TokenEdits
            input_stream: original
            next_offset: 0
            total_bytes: length
            accumulated: OutputBuffer::new!)

    @slice_output: ByteRange -> Result MacroOutput, Diagnostic
    @slice_output = range ->
        // A full SDK slice derives a new anchor from the first segment; an
        // unchanged tree must instead retain the supplied anchor verbatim.
        if range.start == (0 as U64) && range.end == self.total_bytes
            success: Result MacroOutput, Diagnostic = Result::Ok (MacroOutput::from_part (OutputPart::Stream (self.input_stream.clone!)))
            return success
        match self.input_stream.slice range.clone!
            Result::Ok stream => Result::Ok (MacroOutput::from_part (OutputPart::Stream stream))
            Result::Err _ => Result::Err (Diagnostic::new DiagnosticSeverity::Error, (String::from "edit cuts invalid UTF-8 or an opaque capture"), DiagnosticLocation::Invocation)

    ^@replace: &MacroContext -> ByteRange -> MacroOutput -> Result (), Diagnostic
    ^@replace = context, range, replacement ->
        if range.start < self.next_offset || range.end < range.start || range.end > self.total_bytes
            failure: Result (), Diagnostic = Result::Err (context.error (String::from "edit ranges must be ordered, disjoint and inside the original input"))
            return failure
        // Validate both ends even for deletion; never truncate captured expressions.
        self.slice_output range.clone! ?
        prefix = self.slice_output (ByteRange
            start: self.next_offset
            end: range.start) ?
        mut pending = OutputBuffer::new!
        pending.append context, prefix ?
        pending.append context, replacement ?
        self.accumulated.append context, pending.output! ?
        self.next_offset = range.end
        Result::Ok ()

    ~@emit: &MacroContext -> Result MacroOutput, Diagnostic
    ~@emit = context ->
        suffix = self.slice_output (ByteRange
            start: self.next_offset
            end: self.total_bytes) ?
        mut accumulated = self.accumulated
        accumulated.append context, suffix ?
        Result::Ok accumulated.output!

// Decimal U64 construction must not narrow array lengths through signed Show.
decimal: U64 -> String
decimal = value ->
    digits = String::from "0123456789"
    bytes = digits.as_bytes!
    mut reversed: Vec U8 = Vec::new!
    loop
        reversed.push bytes[(value % (10 as U64)) as I64]
        value = value / (10 as U64)
        if value == (0 as U64)
            break
    mut output: Vec U8 = Vec::new!
    i = reversed.len!
    while i > 0
        i = i - 1
        output.push reversed[i]
    String::from output.as_slice!

// Children are output fragments, so fresh/dependency identifiers and captured
// nodes compose without requiring an eager compiler materialization callback.
< struct TypeEmitter

impl TypeEmitter
    emit: &MacroContext -> TypeKind -> &[MacroOutput] -> Result MacroOutput, Diagnostic
    emit = context, kind, children ->
        tag = kind.tag!
        count = children.len!
        valid = if tag == "apply" || tag == "function" then count >= 2 else if tag == "tuple" then count >= 1 else if tag == "path" || tag == "array" then count == 2 else if tag == "unit" || tag == "hole" || tag == "length" then count == 0 else count == 1
        if !valid || count > 16384
            return context.output_error "invalid type emission arity"
        match kind
            TypeKind::Name => context.quote "$0", children
            TypeKind::Associated => context.quote "$0::$1", children
            TypeKind::SharedReference => context.quote "&($0)", children
            TypeKind::MutableReference => context.quote "&mut ($0)", children
            TypeKind::Pointer => context.quote "*($0)", children
            TypeKind::Unit => context.syntax "()"
            TypeKind::Grouped => context.quote "($0)", children
            TypeKind::Slice => context.quote "[$0]", children
            TypeKind::Array => context.quote "[$0; $1]", children
            TypeKind::ArrayLength value =>
                text = decimal value
                context.syntax text.as_str!
            TypeKind::Hole => context.syntax "_"
            _ =>
                mut output = OutputBuffer::new!
                output.append context, (context.syntax "(" ?) ?
                i = 0
                while i < count
                    if i > 0
                        separator = if tag == "function" then " -> " else if tag == "apply" && i == 1 then " " else ", "
                        output.append context, (context.syntax separator ?) ?
                    output.append context, (context.quote "($0)", (&children[i..i + 1]) ?) ?
                    i = i + 1
                if tag == "tuple" && count == 1
                    output.append context, (context.syntax "," ?) ?
                output.append context, (context.syntax ")" ?) ?
                Result::Ok output.output!

// Impl members have an opaque signature and complete definition (e.g. -> body).
// Only their outer layout is generated here; no expression parser is implied.
< struct ImplBuilder
    target: MacroOutput
    trait_type: Option MacroOutput
    bound_output: OutputBuffer
    constraint_count: I64
    member_output: OutputBuffer
    member_count: I64

impl ImplBuilder
    new: MacroOutput -> Option MacroOutput -> ImplBuilder
    new = target, trait_type -> ImplBuilder
        target: target
        trait_type: trait_type
        bound_output: OutputBuffer::new!
        constraint_count: 0
        member_output: OutputBuffer::new!
        member_count: 0

    ^@constrain: &MacroContext -> MacroOutput -> Option MacroOutput -> Result (), Diagnostic
    ^@constrain = context, subject, bound ->
        mut splices: Vec MacroOutput = Vec::new!
        splices.push subject
        prefix = if self.constraint_count == 0 then " where " else ", "
        mut output = OutputBuffer::new!
        output.append context, (context.syntax prefix ?) ?
        match bound
            Option::Some ty =>
                splices.push ty
                output.append context, (context.quote "($0): ($1)", splices.as_slice! ?) ?
            Option::None => output.append context, (context.quote "($0)", splices.as_slice! ?) ?
        self.bound_output.append context, output.output! ?
        self.constraint_count = self.constraint_count + 1
        Result::Ok ()

    ^@member: &MacroContext -> MacroOutput -> MacroOutput -> MacroOutput -> Result (), Diagnostic
    ^@member = context, name, signature, definition ->
        mut splices: Vec MacroOutput = Vec::new!
        splices.push name
        splices.push signature
        splices.push definition
        output = context.quote "\n    $0: $1\n    $0 = $2\n", splices.as_slice! ?
        self.member_output.append context, output ?
        self.member_count = self.member_count + 1
        Result::Ok ()

    ~@emit: &MacroContext -> Result MacroOutput, Diagnostic
    ~@emit = context ->
        if self.member_count == 0
            return context.output_error "an emitted impl needs at least one member"
        mut splices: Vec MacroOutput = Vec::new!
        splices.push self.target
        header = match self.trait_type
            Option::Some trait_type =>
                splices.push trait_type
                context.quote "impl $1 for $0", splices.as_slice! ?
            Option::None => context.quote "impl $0", splices.as_slice! ?
        mut output = OutputBuffer::new!
        output.append context, header ?
        output.append context, self.bound_output.output! ?
        output.append context, self.member_output.output! ?
        Result::Ok output.output!
