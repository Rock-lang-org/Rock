// Bounded declaration layout over original tokens, not an expression parser.
> rock_macro::*
> rock_syntax::*
> rock_syntax::parser::Parser
> rock_syntax::types::TypeNode
> rock_syntax::types::TypeLimits
> rock_syntax::types::GenericParam
> std::collections::vec::Vec
> std::control::option::Option
> std::control::result::Result
> std::clone::Clone
> std::convert::From
> std::string::owned::String
> std::num::arithmetic::Add
> std::num::arithmetic::Sub
> std::num::arithmetic::Mod
> std::cmp::eq::PartialEq
> std::cmp::ord::PartialOrd
> std::ops::index::Index
> std::ops::not::Not

< struct DeclarationLimits
    < max_fields: I64
    < max_variants: I64

impl DeclarationLimits
    standard: DeclarationLimits
    standard = -> DeclarationLimits
        max_fields: 16384
        max_variants: 16384

< enum DeriveKind
    Struct
    Enum

< enum VariantShape
    Nullary
    Named
    Positional

< struct Variant
    < name: Token
    < shape: VariantShape
    < named_fields: Vec Field
    < types: Vec I64
    < range: ByteRange
    < layout_range: ByteRange
    < header_range: ByteRange

< struct Field
    < name: Token
    < public: Bool
    < ty: I64
    < default_range: Option ByteRange
    // Significant syntax, excluding final line trivia.
    < range: ByteRange
    // From this field's physical line start to the next field (or input end).
    < layout_range: ByteRange

< struct DeriveInput
    stream: TokenStream
    arena: Vec TypeNode
    declaration_name: Token
    exported: Bool
    parameters: Vec GenericParam
    members: Vec Field
    variant_nodes: Vec Variant
    enumeration: Bool
    header_range: ByteRange

struct Line
    < start: U64
    < content_end: U64
    < indent: I64
    < supported: Bool

struct Mark
    < line: I64
    < grouped: Bool
    < first: Bool

// Physical lines are indexed once; quotes/comments/captures come from Cursor.
physical_lines: &String -> Vec Line
physical_lines = text ->
    mut lines: Vec Line = Vec::new!
    bytes = text.as_bytes!
    start = 0
    i = 0
    loop
        if i == bytes.len! || bytes[i] == (10 as U8)
            end = i
            if end > start && bytes[end - 1] == (13 as U8)
                end = end - 1
            indent = 0
            while start + indent < end && (bytes[start + indent] == (32 as U8) || bytes[start + indent] == (9 as U8))
                indent = indent + 1
            supported = true
            j = 0
            while j < indent
                if bytes[start + j] == (9 as U8)
                    supported = false
                j = j + 1
            lines.push (Line
                start: start as U64
                content_end: end as U64
                indent: indent
                supported: supported)
            if i == bytes.len!
                break
            start = i + 1
        i = i + 1
    lines

layout_marks: &Parser -> &Vec Line -> &Vec Group -> Vec Mark
layout_marks = parser, lines, groups ->
    mut marks: Vec Mark = Vec::new!
    mut stack: Vec I64 = Vec::new!
    depth = 0
    next_group = 0
    line = 0
    previous_line = -1
    i = 0
    while i < parser.lexemes.len!
        token = &parser.lexemes[i].token
        while line + 1 < lines.len! && lines[line + 1].start <= token.range.start
            line = line + 1
        while depth > 0 && groups[stack[depth - 1]].close.end <= token.range.start
            depth = depth - 1
        marks.push (Mark
            line: line
            grouped: depth > 0
            first: line != previous_line)
        // A multiline quote/capture can end before more code on that same
        // physical line; that tail is not a new field boundary.
        end_line = line
        while end_line + 1 < lines.len! && lines[end_line + 1].start < token.range.end
            end_line = end_line + 1
        previous_line = end_line
        if next_group < groups.len! && groups[next_group].open.start >= token.range.start && groups[next_group].open.start < token.range.end
            if depth == stack.len!
                stack.push next_group
            else
                stack.set depth, next_group
            depth = depth + 1
            next_group = next_group + 1
        i = i + 1
    marks

// A header/type window never consumes a sibling's first token.
line_stop: &Vec Mark -> I64 -> I64 -> I64
line_stop = marks, start, stop ->
    line = marks[start].line
    index = start + 1
    while index < stop && marks[index].line == line
        index = index + 1
    index

body_stop: &Vec Line -> &Vec Mark -> I64 -> I64 -> I64 -> I64
body_stop = lines, marks, start, stop, margin ->
    index = start
    while index < stop
        mark = &marks[index]
        if mark.first && !mark.grouped && lines[mark.line].indent <= margin
            break
        index = index + 1
    index

impl Parser
    @decl_margin: &Vec Line -> &Vec Mark -> I64 -> Result I64, ParseError
    @decl_margin = lines, marks, parent_margin ->
        index = self.lexeme_index
        mark = &marks[index]
        line = &lines[mark.line]
        if !mark.first || mark.grouped || !line.supported || line.indent % 2 != 0 || line.indent > 254 || line.indent <= parent_margin
            failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::InvalidDeclarationIndent)
            return failure
        if line.start + (line.indent as U64) != self.lexemes[index].token.range.start
            failure: Result I64, ParseError = Result::Err (self.failure ParseErrorKind::UnsupportedDeclarationBoundary)
            return failure
        Result::Ok (line.indent)

    ^@read_decl_fields: &Vec Line -> &Vec Mark -> I64 -> I64 -> I64 -> U64 -> I64 -> Result (Vec Field), ParseError
    ^@read_decl_fields = lines, marks, parent_margin, required_margin, last_stop, source_end, field_limit ->
        mut fields: Vec Field = Vec::new!
        body_indent = required_margin
        while self.lexeme_index < last_stop
            first_index = self.lexeme_index
            mark = &marks[first_index]
            line = &lines[mark.line]
            self.lexeme_stop = last_stop
            self.stop_offset = source_end
            margin = self.decl_margin lines, marks, parent_margin ?
            if body_indent < 0
                body_indent = margin
            if margin != body_indent
                failure: Result (Vec Field), ParseError = Result::Err (self.failure ParseErrorKind::InvalidDeclarationIndent)
                return failure
            if fields.len! >= field_limit
                failure: Result (Vec Field), ParseError = Result::Err (self.failure ParseErrorKind::DeclarationFieldLimit)
                return failure
            first_line_stop = line_stop marks, first_index, last_stop
            field_stop = body_stop lines, marks, first_line_stop, last_stop, body_indent
            self.lexeme_stop = first_line_stop
            self.stop_offset = line.content_end
            start = self.lexemes[first_index].token.range.start
            public = (self.at "<") && self.lexemes[self.lexeme_index].token.tag! == "operator"
            if public
                self.take! ?
            if self.lexeme_index >= first_line_stop || self.lexemes[self.lexeme_index].token.tag! != "ident"
                failure: Result (Vec Field), ParseError = Result::Err (self.failure ParseErrorKind::ExpectedField)
                return failure
            index = self.take! ?
            field_name = copy_token (&self.lexemes[index].token)
            if !(self.at ":")
                failure: Result (Vec Field), ParseError = Result::Err (self.failure ParseErrorKind::ExpectedFieldColon)
                return failure
            self.take! ?
            ty = self.read_type 0 ?
            mut default_range: Option ByteRange = Option::None
            if self.lexeme_index < first_line_stop
                if !(self.at "=")
                    failure: Result (Vec Field), ParseError = Result::Err (self.failure ParseErrorKind::ExpectedFieldEnd)
                    return failure
                self.take! ?
                if self.lexeme_index >= field_stop
                    failure: Result (Vec Field), ParseError = Result::Err (self.failure ParseErrorKind::ExpectedFieldDefault)
                    return failure
                if self.lexeme_index >= first_line_stop
                    failure: Result (Vec Field), ParseError = Result::Err (self.failure ParseErrorKind::UnsupportedDeclarationBoundary)
                    return failure
                default_range = Option::Some (ByteRange
                    start: self.lexemes[self.lexeme_index].token.range.start
                    end: self.lexemes[field_stop - 1].token.range.end)
            else
                if field_stop != first_line_stop
                    self.lexeme_stop = field_stop
                    failure: Result (Vec Field), ParseError = Result::Err (self.failure ParseErrorKind::UnsupportedDeclarationBoundary)
                    return failure
            i = first_line_stop
            while i < field_stop
                item = &marks[i]
                continuation = &lines[item.line]
                if item.first && !item.grouped && (!continuation.supported || continuation.indent % 2 != 0 || continuation.indent > 254)
                    token = &self.lexemes[i].token
                    failure: Result (Vec Field), ParseError = Result::Err (ParseError::at ParseErrorKind::InvalidDeclarationIndent, (token.range.start), (token.range.end))
                    return failure
                i = i + 1
            layout_end = if field_stop < last_stop then lines[marks[field_stop].line].start else source_end
            fields.push (Field
                name: field_name
                public: public
                ty: ty
                default_range: default_range
                range: ByteRange
                    start: start
                    end: self.lexemes[field_stop - 1].token.range.end
                layout_range: ByteRange
                    start: line.start
                    end: layout_end)
            self.lexeme_index = field_stop
        Result::Ok fields

    ^@read_decl_variants: &Vec Line -> &Vec Mark -> I64 -> U64 -> &DeclarationLimits -> Result (Vec Variant), ParseError
    ^@read_decl_variants = lines, marks, header_indent, source_end, limits ->
        mut variants: Vec Variant = Vec::new!
        body_indent = -1
        used_fields = 0
        stop = self.lexemes.len!
        while self.lexeme_index < stop
            first = self.lexeme_index
            self.lexeme_stop = stop
            self.stop_offset = source_end
            margin = self.decl_margin lines, marks, header_indent ?
            if body_indent < 0
                body_indent = margin
            if margin != body_indent
                failure: Result (Vec Variant), ParseError = Result::Err (self.failure ParseErrorKind::InvalidDeclarationIndent)
                return failure
            if variants.len! >= limits.max_variants
                failure: Result (Vec Variant), ParseError = Result::Err (self.failure ParseErrorKind::DeclarationVariantLimit)
                return failure
            line = &lines[marks[first].line]
            first_line_stop = line_stop marks, first, stop
            variant_stop = body_stop lines, marks, first_line_stop, stop, body_indent
            layout_end = if variant_stop < stop then lines[marks[variant_stop].line].start else source_end
            self.lexeme_stop = first_line_stop
            self.stop_offset = line.content_end
            if !(self.is_name first)
                failure: Result (Vec Variant), ParseError = Result::Err (self.failure ParseErrorKind::ExpectedVariant)
                return failure
            self.take! ?
            name = copy_token (&self.lexemes[first].token)
            mut positional: Vec I64 = Vec::new!
            while self.starts_atom (self.lexeme_index)
                if used_fields >= limits.max_fields
                    failure: Result (Vec Variant), ParseError = Result::Err (self.failure ParseErrorKind::DeclarationFieldLimit)
                    return failure
                // Grouped arguments are individual fields; otherwise the full
                // type parser owns application/arrow commas, like parse_type_inner.
                ty = if self.at "(" then self.atom 0 ? else self.read_type 0 ?
                positional.push ty
                used_fields = used_fields + 1
                if self.at ","
                    self.take! ?
            if self.lexeme_index != first_line_stop
                failure: Result (Vec Variant), ParseError = Result::Err (self.failure ParseErrorKind::ExpectedVariantEnd)
                return failure
            mut fields: Vec Field = Vec::new!
            header_end = layout_end
            if first_line_stop < variant_stop
                if positional.len! > 0
                    self.lexeme_stop = variant_stop
                    failure: Result (Vec Variant), ParseError = Result::Err (self.failure ParseErrorKind::UnsupportedVariantShape)
                    return failure
                header_end = lines[marks[first_line_stop].line].start
                field_margin = body_indent + body_indent - header_indent
                remaining = limits.max_fields - used_fields
                fields = self.read_decl_fields lines, marks, body_indent, field_margin, variant_stop, layout_end, remaining ?
                used_fields = used_fields + fields.len!
            shape = if positional.len! > 0 then VariantShape::Positional else if fields.len! > 0 then VariantShape::Named else VariantShape::Nullary
            variants.push (Variant
                name: name
                shape: shape
                named_fields: fields
                types: positional
                range: ByteRange
                    start: self.lexemes[first].token.range.start
                    end: self.lexemes[variant_stop - 1].token.range.end
                layout_range: ByteRange
                    start: line.start
                    end: layout_end
                header_range: ByteRange
                    start: line.start
                    end: header_end)
            self.lexeme_index = variant_stop
        Result::Ok variants

copy_token: &Token -> Token
copy_token = token ->
    retained = &token.context
    context = match *retained
        Option::Some context => Option::Some (context.clone!)
        Option::None => Option::None
    Token
        kind: if token.tag! == "type" then TokenKind::Type else TokenKind::Ident
        range: token.range.clone!
        context: context

impl DeriveInput
    parse: TokenStream -> Result DeriveInput, ParseError
    parse = input -> DeriveInput::parse_with_limits input, Limits::standard!, TypeLimits::standard!, DeclarationLimits::standard!

    parse_with_limits: TokenStream -> Limits -> TypeLimits -> DeclarationLimits -> Result DeriveInput, ParseError
    parse_with_limits = input, lexical_limits, type_limits, limits ->
        if limits.max_fields < 0 || limits.max_fields > 16384 || limits.max_variants < 0 || limits.max_variants > 16384
            failure: Result DeriveInput, ParseError = Result::Err (ParseError::at ParseErrorKind::InvalidLimits, 0, 0)
            return failure
        mut parser = Parser::new input, lexical_limits, type_limits ?
        groups = parser.lexer_cursor.all_groups! ?
        text = match parser.lexer_cursor.input!.spelling!
            Result::Ok text => text
            Result::Err error =>
                failure: Result DeriveInput, ParseError = Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), 0, 0)
                return failure
        lines = physical_lines &text
        marks = layout_marks &parser, &lines, &groups
        if parser.lexemes.len! == 0
            failure: Result DeriveInput, ParseError = Result::Err (parser.failure ParseErrorKind::ExpectedDeclaration)
            return failure
        header_line = marks[0].line
        header_indent = lines[header_line].indent
        if !lines[header_line].supported || header_indent % 2 != 0 || header_indent > 254
            failure: Result DeriveInput, ParseError = Result::Err (parser.failure ParseErrorKind::InvalidDeclarationIndent)
            return failure
        if lines[header_line].start + (header_indent as U64) != parser.lexemes[0].token.range.start
            failure: Result DeriveInput, ParseError = Result::Err (parser.failure ParseErrorKind::UnsupportedDeclarationBoundary)
            return failure
        header_stop = 0
        while header_stop < marks.len! && marks[header_stop].line == header_line
            header_stop = header_stop + 1
        parser.lexeme_stop = header_stop
        parser.stop_offset = lines[header_line].content_end
        exported = (parser.at "<") && parser.lexemes[parser.lexeme_index].token.tag! == "operator"
        if exported
            parser.take! ?
        enumeration = parser.at "enum"
        if !enumeration && !(parser.at "struct")
            failure: Result DeriveInput, ParseError = Result::Err (parser.failure ParseErrorKind::ExpectedDeclaration)
            return failure
        parser.take! ?
        if !(parser.is_name (parser.lexeme_index))
            failure: Result DeriveInput, ParseError = Result::Err (parser.failure ParseErrorKind::ExpectedDeclarationName)
            return failure
        name_index = parser.take! ?
        name = copy_token (&parser.lexemes[name_index].token)
        mut parameters: Vec GenericParam = Vec::new!
        while parser.lexeme_index < header_stop
            parameter = parser.binder! ?
            parameters.push parameter
            if !(parser.at ",")
                break
            parser.take! ?
        if parser.lexeme_index != header_stop
            failure: Result DeriveInput, ParseError = Result::Err (parser.failure ParseErrorKind::ExpectedHeaderEnd)
            return failure
        mut fields: Vec Field = Vec::new!
        mut variants: Vec Variant = Vec::new!
        header_end = text.len! as U64
        stop = parser.lexemes.len!
        end = text.len! as U64
        if parser.lexeme_index < stop
            header_end = lines[marks[parser.lexeme_index].line].start
        if enumeration
            variants = parser.read_decl_variants &lines, &marks, header_indent, end, &limits ?
        else
            fields = parser.read_decl_fields &lines, &marks, header_indent, -1, stop, end, (limits.max_fields) ?
        Result::Ok (DeriveInput
            stream: parser.lexer_cursor.input!.clone!
            arena: parser.arena
            declaration_name: name
            exported: exported
            parameters: parameters
            members: fields
            variant_nodes: variants
            enumeration: enumeration
            header_range: ByteRange
                start: 0
                end: header_end)

    @decl_kind: DeriveKind
    @decl_kind = -> if self.enumeration then DeriveKind::Enum else DeriveKind::Struct

    @decl_name: &Token
    @decl_name = -> &self.declaration_name

    @is_public: Bool
    @is_public = -> self.exported

    @params: &Vec GenericParam
    @params = -> &self.parameters

    @fields: &Vec Field
    @fields = -> &self.members

    @variants: &Vec Variant
    @variants = -> &self.variant_nodes

    @nodes: &Vec TypeNode
    @nodes = -> &self.arena

    @header: &ByteRange
    @header = -> &self.header_range

    @original: &TokenStream
    @original = -> &self.stream

    @emit: TokenStream
    @emit = -> self.stream.clone!

    @field_tokens: I64 -> Result TokenStream, ParseError
    @field_tokens = index ->
        if index < 0 || index >= self.members.len!
            failure: Result TokenStream, ParseError = Result::Err (ParseError::at (ParseErrorKind::InvalidFieldIndex index), 0, 0)
            return failure
        match self.stream.slice (self.members[index].range.clone!)
            Result::Ok tokens => Result::Ok tokens
            Result::Err error => Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), 0, 0)

    @variant_tokens: I64 -> Result TokenStream, ParseError
    @variant_tokens = index ->
        if index < 0 || index >= self.variant_nodes.len!
            failure: Result TokenStream, ParseError = Result::Err (ParseError::at (ParseErrorKind::InvalidVariantIndex index), 0, 0)
            return failure
        match self.stream.slice (self.variant_nodes[index].range.clone!)
            Result::Ok tokens => Result::Ok tokens
            Result::Err error => Result::Err (ParseError::at (ParseErrorKind::InvalidInput error), 0, 0)

impl VariantShape
    @tag: &Str
    @tag = ->
        match *self
            VariantShape::Nullary => "nullary"
            VariantShape::Named => "named"
            VariantShape::Positional => "positional"
