// Exercises every std operation that goes through an OS backend. Run it in
// an empty working directory on each supported platform. A failing step
// exits with its own code (10, 20, ...) so CI logs name the broken operation;
// success prints `platform smoke ok` and exits 0.

> std::io::fs::File
> std::io::fs::read_to_string
> std::io::IoError
> std::io::net::TcpListener
> std::io::net::TcpStream
> std::io::net::SocketAddrV4
> std::concurrency::thread::spawn
> std::concurrency::thread::sleep_ms
> std::control::Result
> std::env::args
> std::collections::vec::Vec

// Non-ASCII file name: exercises UTF-8 to native path conversion.
file_name = -> "smoke-ünïcødé-é.txt"

write_then_append: () -> Result I64, IoError
write_then_append = ->
    mut created = File::create file_name!?
    created.write_str "first"?
    created.close!?
    mut appended = File::append file_name!?
    written = appended.write_str "-second"?
    Result::Ok written

append_new: () -> Result I64, IoError
append_new = ->
    mut file = File::append "smoke-append-new.txt"?
    written = file.write_str "fresh"?
    file.close!?
    Result::Ok written

loopback: () -> Result I64, IoError
loopback = ->
    listener = TcpListener::bind (SocketAddrV4::localhost 0)?
    addr = listener.local_addr!?
    mut client = TcpStream::connect addr?
    mut server = listener.accept!?
    client.write_str "ping"?
    client.shutdown_write!?
    // A blocking read may return fewer bytes than were sent: read to EOF.
    mut received: Vec U8 = Vec::new!
    mut chunk = [0 as U8, 0, 0, 0]
    done = false
    while !done && received.len! < 8
        count = server.read (&mut chunk)?
        if count == 0
            done = true
        else
            received.extend_from_slice (&chunk[..count])
    if received.len! == 4 && received[0] == (112 as U8) && received[1] == (105 as U8) && received[2] == (110 as U8) && received[3] == (103 as U8)
        Result::Ok received.len!
    else
        Result::Ok 0

// Writing to a peer that has closed must report an error, not kill the
// process (SIGPIPE on Unix).
closed_peer_write: () -> Result Bool, IoError
closed_peer_write = ->
    listener = TcpListener::bind (SocketAddrV4::localhost 0)?
    addr = listener.local_addr!?
    mut client = TcpStream::connect addr?
    server = listener.accept!?
    server.close!?
    failed = false
    attempts = 0
    // The first writes may succeed until the peer's reset arrives.
    while !failed && attempts < 100
        match client.write_str "x"
            Result::Ok _ => sleep_ms 10
            Result::Err _ => failed = true
        attempts = attempts + 1
    Result::Ok failed

main = ->
    // Arguments: the harness passes one non-ASCII argument, which must
    // arrive as UTF-8 on every platform.
    arguments = args!
    if arguments.len! != 2
        return 10
    if arguments[1] != "café-ü"
        return 11

    // Files: create, close, append, read back.
    match write_then_append!
        Result::Ok 7 => ()
        _ => return 20
    match read_to_string file_name!
        Result::Ok text =>
            if text != "first-second"
                return 21
        Result::Err _ => return 22

    // Append creates a missing file without truncating anything.
    match append_new!
        Result::Ok 5 => ()
        _ => return 23
    match read_to_string "smoke-append-new.txt"
        Result::Ok text =>
            if text != "fresh"
                return 24
        Result::Err _ => return 25

    // A missing file reports an OS error rather than crashing.
    match File::open "definitely-missing-file.txt"
        Result::Err (IoError::Os _) => ()
        _ => return 30

    // Sockets: loopback round trip.
    match loopback!
        Result::Ok 4 => ()
        _ => return 40
    match closed_peer_write!
        Result::Ok true => ()
        _ => return 41

    // Threads: spawn, sleep inside the thread, join with a value.
    match spawn (->
        sleep_ms 5
        42)
        Result::Ok handle =>
            match handle.join!
                Result::Ok 42 => ()
                _ => return 50
        Result::Err _ => return 51

    // Float formatting goes through the C runtime.
    if (1.5).show! != "1.5"
        return 60

    "platform smoke ok".println!
    0
